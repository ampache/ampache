# Ampache API shape-verification config.
#
# Copy this file to `verify.env` (gitignored) and fill it in, or point the script
# at any file with `--env <path>`. Real environment variables override file values.
#
#   cp verify.env.example verify.env
#   python verify_openapi_shapes.py

# Base URL of your Ampache server, no trailing slash.
# e.g. https://music.example.com   (the script calls {HOST}/server/{json,xml}.server.php)
AMPACHE_HOST=

# Login user. Required for password auth; also used to hash the API key.
AMPACHE_USER=

# Password. Used only when AMPACHE_APIKEY is empty.
AMPACHE_PASSWORD=

# Optional API key. If set (non-empty), it is used instead of the password.
AMPACHE_APIKEY=

# API version to request. These schemas describe version 8; verifying against an
# older server will report shape differences that are really version differences.
AMPACHE_API_VERSION=8

# Set to 0 to skip TLS certificate verification (self-signed home servers).
AMPACHE_VERIFY_SSL=1
