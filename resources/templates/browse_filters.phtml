// browse_filters.phtml -- rendered by Ampache\Gui\Browse\BrowseFiltersView

use Ampache\Module\Api\Ajax;

/** @var Ampache\Gui\Browse\BrowseFiltersView $this */

if ($this->isEmpty()) {
    return;
}

$browse     = $this->getBrowse();
$browseId   = $browse->id;
$argument   = $this->getArgumentParam();
$browseUrl  = '?page=browse&action=browse&browse_id=' . $browseId;
$matchModes = $this->getMatchModes(); ?>
<li>
    <h4><?php echo T_('Filters'); ?></h4>
    <div class="sb3">
    <?php if ($this->hasFilter('starts_with')) { ?>
        <form id="multi_alpha_filter_form" action="javascript:void(0);">
            <label id="multi_alpha_filterLabel" for="multi_alpha_filter"><?php echo T_('Name'); ?></label>
            <?php if (count($matchModes) > 1) { ?>
            <select id="multi_alpha_filter_match" name="multi_alpha_filter_match">
                <?php foreach ($matchModes as $mode => $label) { ?>
                <option value="<?php echo $this->e($mode); ?>"<?php echo ($mode === $this->getSelectedMatchMode()) ? ' selected="selected"' : ''; ?>><?php echo $this->e($label); ?></option>
                <?php } ?>
            </select>
            <?php } ?>
            <input type="text" id="multi_alpha_filter" name="multi_alpha_filter" value="<?php echo $this->e($this->getMatchValue()); ?>" onBlur="delayRun(this, '400', 'ajaxState', '<?php echo $this->e(Ajax::url($browseUrl . '&key=starts_with' . $argument)); ?>', 'multi_alpha_filter_form');">
        </form>
        <?php if (count($matchModes) > 1) {
            echo $this->raw(Ajax::observe('multi_alpha_filter_match', 'change', Ajax::action($browseUrl . '&key=starts_with' . $argument, '', 'multi_alpha_filter_form')));
        }
    }

if ($this->hasFilter('minimum_count')) { ?>
        <input id="mincountCB" type="checkbox" value="1" />
        <label id="mincountLabel" for="mincountCB"><?php echo T_('Minimum Count'); ?></label><br />
        <?php echo $this->raw(Ajax::observe('mincountCB', 'click', Ajax::action($browseUrl . '&key=min_count&value=1' . $argument, '')));
}

if ($this->hasFilter('rated')) { ?>
        <input id="ratedCB" type="checkbox" value="1" />
        <label id="ratedLabel" for="ratedCB"><?php echo T_('Rated'); ?></label><br />
        <?php echo $this->raw(Ajax::observe('ratedCB', 'click', Ajax::action($browseUrl . '&key=rated&value=1' . $argument, '')));
}

if ($this->hasFilter('unplayed')) { ?>
        <input id="unplayedCB" type="checkbox"<?php echo $this->isFilterActive('unplayed') ? ' checked="checked"' : ''; ?> />
        <label id="unplayedLabel" for="unplayedCB"><?php echo T_('Unplayed'); ?></label><br />
        <?php echo $this->raw(Ajax::observe('unplayedCB', 'click', Ajax::action($browseUrl . '&key=unplayed&value=1' . $argument, '')));
}

if ($this->hasFilter('playlist_type')) { ?>
        <input id="show_allplCB" type="checkbox" value="1"<?php echo $this->isFilterActive('playlist_type') ? ' checked="checked"' : ''; ?> />
        <label id="show_allplLabel" for="show_allplCB"><?php echo T_('All Playlists'); ?></label><br />
        <?php echo $this->raw(Ajax::observe('show_allplCB', 'click', Ajax::action($browseUrl . '&key=playlist_type&value=1' . $argument, '')));
}

if ($this->hasFilter('catalog')) { ?>
        <form method="post" id="catalog_choice" action="javascript.void(0);">
            <label id="catalogLabel" for="catalog_select"><?php echo T_('Catalog'); ?></label><br />
            <select id="catalog_select" name="catalog_key">
                <option value="0"><?php echo T_('All'); ?></option>
                <?php foreach ($this->getCatalogs() as $catalogId => $catalogName) { ?>
                <option value="<?php echo $this->e($catalogId); ?>"<?php echo ($catalogId === $this->getSelectedCatalogId()) ? ' selected="selected"' : ''; ?>><?php echo $this->e($catalogName); ?></option>
                <?php } ?>
            </select>
            <?php echo $this->raw(Ajax::observe('catalog_select', 'change', Ajax::action($browseUrl . $argument, 'catalog_select', 'catalog_choice'))); ?>
        </form>
        <?php }

if ($this->hasFilter('show_art')) { ?>
        <?php echo T_('Toggle Artwork'); ?>&nbsp;<input id="show_artCB" type="checkbox" checked="checked" />
        <?php echo $this->raw(Ajax::observe('show_artCB', 'click', Ajax::action('?page=browse&action=show_art&browse_id=' . $browseId . $argument, '')));
} ?>
    </div>
</li>
