// recommended_artists.phtml -- rendered by Ampache\Gui\Artist\RecommendedArtistsView

use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Artist\RecommendedArtistsView $this */

$columns = $this->getColumns();
if ($this->areRatingsShown()) {
    Rating::build_cache('artist', $this->getArtistIds());
    Userflag::build_cache('artist', $this->getArtistIds());
}

Ui::show_box_top(T_('Similar Artists'), 'info-box'); ?>
<table class="tabledata striped-rows">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($this->getArtists() as $artist) { ?>
        <tr id="artist_<?php echo $this->e($artist->id); ?>">
            <?php echo $this->raw($this->renderRow($artist)); ?>
        </tr>
        <?php }

        foreach ($this->getMissingArtists() as $missing) { ?>
        <tr id="missing_artist_<?php echo $this->e($missing['mbid']); ?>">
            <td></td>
            <td colspan="<?php echo count($columns) - 1; ?>"><a class="missing_album" href="<?php echo $this->e($this->getMissingArtistUrl($missing['mbid'])); ?>" title="<?php echo $this->e($missing['name']); ?>"><?php echo $this->e($missing['name']); ?></a></td>
        </tr>
        <?php }

        if ($this->isEmpty()) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('No similar artist found'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php Ui::show_box_bottom(); ?>
