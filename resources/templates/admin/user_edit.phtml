        <tr>
            <td><?php echo T_('State'); ?></td>
            <td><input type="text" name="state" maxlength="64" value="<?php echo $this->e($this->getState()); ?>" autocomplete="off" />
                <?php echo $this->raw(AmpError::display('state')); ?>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('City'); ?></td>
            <td><input type="text" name="city" maxlength="64" value="<?php echo $this->e($this->getCity()); ?>" autocomplete="off" />
                <?php echo $this->raw(AmpError::display('city')); ?>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('Password'); ?></td>
            <td><input type="password" name="password_1" maxlength="64" value="" autocomplete="new-password" />
                <?php echo $this->raw(AmpError::display('password')); ?>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('Confirm Password'); ?></td>
            <td><input type="password" name="password_2" maxlength="64" value="" autocomplete="new-password" /></td>
        </tr>
        <tr>
            <td>
                <?php echo T_('Subsonic Password'); ?>
                <?php if ($this->hasSubsonicSecret()) { ?>
                <a href="<?php echo $this->e($adminPath); ?>/users.php?action=show_delete_subsonic_secret&user_id=<?php echo $userId; ?>"><?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?></a>
                <?php } ?>
            </td>
            <td><input type="password" name="subsonic_password_1" maxlength="64" value="" autocomplete="new-password" />
                <?php echo $this->raw(AmpError::display('subsonic_password')); ?>
                <span><?php echo ($this->hasSubsonicSecret()) ? T_('Currently set') : T_('Not set'); ?></span>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('Confirm Password'); ?></td>
            <td><input type="password" name="subsonic_password_2" maxlength="64" value="" autocomplete="new-password" /></td>
        </tr>
