// admin/user_edit.phtml -- rendered by Ampache\Gui\Admin\UserEditView

use Ampache\Module\System\AmpError;
use Ampache\Module\System\Core;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Admin\UserEditView $this */

$userId    = $this->getUserId();
$adminPath = $this->getAdminPath();
$access    = $this->getAccessLevel();
$isAdmin   = $this->isAdmin();
$apikey    = $this->getApikey();
Ui::show_box_top(T_('Editing Existing User'));
echo $this->raw(AmpError::display('general')); ?>
<form name="update_user" enctype="multipart/form-data" method="post" action="<?php echo $this->e($this->getFormAction()); ?>">
    <table class="tabledata">
        <tr>
            <th colspan="2"><?php echo T_('User Properties'); ?></th>
        </tr>
        <tr>
            <td><?php echo T_('Username'); ?></td>
            <td><input type="text" name="username" maxlength="128" value="<?php echo $this->e($this->getUsername()); ?>" autocomplete="off" autofocus />
                <?php echo $this->raw(AmpError::display('username')); ?>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('Full Name'); ?></td>
            <td><input type="text" name="fullname" maxlength="255" value="<?php echo $this->e($this->getFullname()); ?>" />
                <input type="checkbox" name="fullname_public" value="1" <?php echo ($this->isFullnamePublic()) ? 'checked' : ''; ?> /> <?php echo T_('Public'); ?>
                <?php echo $this->raw(AmpError::display('fullname')); ?>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('E-mail'); ?></td>
            <td><input type="text" name="email" maxlength="128" value="<?php echo $this->e($this->getEmail()); ?>" />
                <?php echo $this->raw(AmpError::display('email')); ?>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('Website'); ?></td>
            <td><input type="text" name="website" maxlength="255" value="<?php echo $this->e($this->getWebsite()); ?>" />
