// browse/wanted_albums.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\WantedListRenderer

use Ampache\Gui\Wanted\WantedAlbumRowView;
use Ampache\Module\Api\Ajax;

/** @var Ampache\Gui\Browse\ListRenderer\WantedListRenderer $this */

// show_objects() closes the box itself, so this does not emit its own box bottom
$browse  = $this->getBrowse();
$columns = $this->getColumns();
$albums  = $this->getWantedAlbums(); ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="wanted">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=wanted&sort=' . $column['sort'], $column['label'], 'wanted_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($albums as $album) { ?>
        <tr id="walbum_<?php echo $this->e($album->getMusicBrainzId()); ?>">
            <?php echo $this->raw((new WantedAlbumRowView($album))->render()); ?>
        </tr>
        <?php } ?>
        <?php if ($albums === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('No missing albums found'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
</table>
