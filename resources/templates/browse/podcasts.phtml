// browse/podcasts.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\PodcastListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\PodcastListRenderer $this */

$browse   = $this->getBrowse();
$columns  = $this->getColumns();
$podcasts = $this->getPodcasts();
if ($this->areRatingsShown()) {
    Rating::build_cache('podcast', $this->getObjectIds());
    Userflag::build_cache('podcast', $this->getObjectIds());
} ?>
<div id="information_actions">
    <ul>
        <?php if ($this->mayManage()) { ?>
        <li>
            <a href="<?php echo $this->e($this->getSubscribeUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('add_circle', T_('Add'))); ?>
                <?php echo T_('Subscribe to Podcast'); ?>
            </a>
        </li>
        <li>
            <a href="<?php echo $this->e($this->getImportUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('upload', T_('Import'))); ?>
                <?php echo T_('Import'); ?>
            </a>
        </li>
        <?php } ?>
        <li>
            <a href="<?php echo $this->e($this->getExportUrl()); ?>" target="_blank" rel="noopener">
                <?php echo $this->raw(Ui::get_material_symbol('download', T_('Export'))); ?>
                <?php echo T_('Export'); ?>
            </a>
        </li>
    </ul>
</div>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="podcast">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&sort=' . $column['sort'], $column['label'], 'podcast_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($podcasts as $podcast) { ?>
        <tr id="podcast_<?php echo $this->e($podcast->getId()); ?>" class="libitem_menu" data-object-type="podcast" data-object-id="<?php echo $this->e($podcast->getId()); ?>">
            <?php echo $this->raw($this->renderRow($podcast)); ?>
        </tr>
        <?php } ?>
        <?php if ($podcasts === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
