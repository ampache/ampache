// browse/playlist_medias.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\PlaylistMediaListRenderer

use Ampache\Gui\Partial\MultiselectActionsView;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\PlaylistMediaListRenderer $this */

$browse              = $this->getBrowse();
$argument_param      = $this->getArgumentParam();
$columns             = $this->getColumns();
$rows                = $this->getRows();
$playlistId          = $this->getPlaylistId();
$showMultiselect     = $this->showMultiselect();
$multiselect_actions = $this->getMultiselectActions();
if ($this->showRatings()) {
    $ratingIds = [];
    foreach ($rows as $row) {
        $ratingIds[$row['type']][] = $row['item']->getId();
    }

    foreach ($ratingIds as $ratingType => $ratingIdList) {
        Rating::build_cache($ratingType, $ratingIdList);
        Userflag::build_cache($ratingType, $ratingIdList);
    }
}

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
    echo '<span class="item-duration">| ' . T_('Duration') . ': ' . $this->e($this->getDuration()) . '</span>';
} ?>
<div<?php echo ($showMultiselect) ? ' data-multiselect-scope' : ''; ?>>
    <?php if ($showMultiselect) {
        echo $this->raw((new MultiselectActionsView($multiselect_actions))->render());
    } ?>
    <form method="post" id="reorder_playlist_<?php echo $this->e($playlistId); ?>">
        <table id="reorder_playlist_table" class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="media" data-offset="<?php echo $this->e($browse->get_start()); ?>">
            <thead>
                <tr class="th-top">
                    <?php foreach ($columns as $column) { ?>
                    <th class="<?php echo $this->e($column['class']); ?>"><?php
                        if ($column['class'] === 'cel_select essential persist' && $showMultiselect) {
                            echo '<input type="checkbox" class="multiselect-all" title="' . $this->e(T_('Select')) . '" />';
                        } elseif ($column['header']) {
                            echo $this->e($column['label']);
                        } ?></th>
                    <?php } ?>
                </tr>
            </thead>
            <tbody id="sortableplaylist_<?php echo $this->e($playlistId); ?>">
                <?php foreach ($rows as $row) { ?>
                <tr id="track_<?php echo $this->e($row['trackId']); ?>">
                    <?php echo $this->raw($this->renderRow($row)); ?>
                </tr>
                <?php } ?>
                <?php if ($rows === []) { ?>
                <tr>
                    <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
                </tr>
                <?php } ?>
            </tbody>
            <tfoot>
                <tr class="th-bottom">
                    <?php foreach ($columns as $column) { ?>
                    <th class="<?php echo $this->e(explode(' ', $column['class'])[0]); ?>"><?php echo $this->e($column['label']); ?></th>
                    <?php } ?>
                </tr>
            </tfoot>
        </table>
    </form>
</div>
<?php show_table_render($this->isReorderable()); ?>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
    echo '<span class="item-duration">| ' . T_('Duration') . ': ' . $this->e($this->getDuration()) . '</span>';
} ?>
