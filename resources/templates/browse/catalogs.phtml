// browse/catalogs.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\CatalogListRenderer

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\CatalogListRenderer $this */

$browse   = $this->getBrowse();
$columns  = $this->getColumns();
$catalogs = $this->getCatalogs();

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="catalog">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($catalogs as $catalog) { ?>
        <tr id="catalog_<?php echo $this->e($catalog->id); ?>">
            <?php echo $this->raw($this->renderRow($catalog)); ?>
        </tr>
        <?php } ?>
        <?php if ($catalogs === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
