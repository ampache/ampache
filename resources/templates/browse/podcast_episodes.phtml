// browse/podcast_episodes.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\PodcastEpisodeListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\PodcastEpisodeListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$episodes       = $this->getEpisodes();
if ($this->areRatingsShown()) {
    Rating::build_cache('podcast_episode', $this->getObjectIds());
    Userflag::build_cache('podcast_episode', $this->getObjectIds());
}

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="podcast_episode">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&sort=' . $column['sort'], $column['label'], 'podcast_episode_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($episodes as $episode) { ?>
        <tr id="podcast_episode_<?php echo $this->e($episode->id); ?>" class="libitem_menu" data-object-type="podcast_episode" data-object-id="<?php echo $this->e($episode->id); ?>">
            <?php echo $this->raw($this->renderRow($episode)); ?>
        </tr>
        <?php } ?>
        <?php if ($episodes === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('No podcast episode found'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php show_table_render();

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
