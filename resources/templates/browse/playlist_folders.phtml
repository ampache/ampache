// browse/playlist_folders.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\PlaylistFolderListRenderer

use Ampache\Gui\Browse\ListHeaderView;
use Ampache\Module\Util\Ui;
use Ampache\Repository\Model\PlaylistFolder;

/** @var Ampache\Gui\Browse\ListRenderer\PlaylistFolderListRenderer $this */

$browse          = $this->getBrowse();
$argument_param  = $this->getArgumentParam();
$columns         = $this->getColumns();
$rows            = $this->getRows();
$currentFolder   = $this->getCurrentFolder();
$currentFolderId = $this->getCurrentFolderId();
$ancestors       = $this->getAncestors();
$mayCreate       = $this->mayCreate();
$moveOptions     = ($mayCreate) ? $this->getMoveFolderOptions() : [];

if ($mayCreate) { ?>
<div id="information_actions">
    <ul>
        <li>
            <a href="<?php echo $this->e($this->getCreateFolderUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('create_new_folder', T_('Create Folder'))); ?>
                <?php echo T_('Create Folder'); ?>
            </a>
        </li>
        <li>
            <a href="<?php echo $this->e($this->getCreatePlaylistUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('add_circle', T_('Create Playlist'))); ?>
                <?php echo T_('Create Playlist'); ?>
            </a>
        </li>
        <li>
            <a href="<?php echo $this->e($this->getCreateSmartPlaylistUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('add_circle', T_('Create Smart Playlist'))); ?>
                <?php echo T_('Create Smart Playlist'); ?>
            </a>
        </li>
    </ul>
</div>
<?php } ?>
<nav class="playlist_folder_breadcrumb">
    <a href="<?php echo $this->e($this->getFolderUrl(PlaylistFolder::ROOT)); ?>"><?php echo T_('Playlist Folders'); ?></a>
    <?php foreach ($ancestors as $ancestor) { ?>
    / <a href="<?php echo $this->e($this->getFolderUrl($ancestor->getId())); ?>"><?php echo $this->e($ancestor->getName()); ?></a>
    <?php }
    if ($currentFolder instanceof PlaylistFolder) { ?>
    / <?php echo $this->e($currentFolder->getName()); ?>
    <?php } ?>
</nav>
<?php if ($browse->is_show_header()) {
    echo $this->raw((new ListHeaderView($browse, true, $argument_param))->render());
} ?>
<table class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="playlist_folder">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($rows as $row) { ?>
        <tr id="playlist_folder_row_<?php echo $this->e($row['type'] . '_' . $row['item']->getId()); ?>">
            <td class="cel_type essential"><?php echo $this->e($this->getRowType($row['type'])); ?></td>
            <td class="cel_name essential persist"><?php echo $this->raw($this->getRowName($row['item'])); ?></td>
            <td class="cel_last_update optional"><?php echo $this->e($this->getRowLastUpdate($row['item'])); ?></td>
            <td class="cel_count optional"><?php echo $this->e($this->getRowItemCount($row['item'])); ?></td>
            <td class="cel_owner essential"><?php echo $this->e($this->getRowOwner($row['item'])); ?></td>
            <td class="cel_action essential">
                <?php if ($mayCreate) {
                    if ($row['item'] instanceof PlaylistFolder) { ?>
                <a href="<?php echo $this->e($this->getEditFolderUrl($row['item']->getId())); ?>">
                    <?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?>
                </a>
                <a href="<?php echo $this->e($this->getDeleteFolderUrl($row['item']->getId())); ?>" data-confirm="<?php echo T_('Do you really want to delete this Folder?'); ?>">
                    <?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?>
                </a>
                    <?php } else { ?>
                <form method="get" action="<?php echo $this->e($this->getMoveFormAction()); ?>" class="playlist_folder_move">
                    <input type="hidden" name="action" value="place" />
                    <input type="hidden" name="object_type" value="<?php echo $this->e($row['type']); ?>" />
                    <input type="hidden" name="object_id" value="<?php echo $this->e($row['item']->id); ?>" />
                    <input type="hidden" name="from" value="<?php echo $currentFolderId; ?>" />
                    <select name="folder">
                        <option value="0"<?php echo ($currentFolderId === 0) ? ' selected="selected"' : ''; ?>><?php echo T_('None'); ?></option>
                        <?php foreach ($moveOptions as $option) { ?>
                        <option value="<?php echo $option['id']; ?>"<?php echo ($option['id'] === $currentFolderId) ? ' selected="selected"' : ''; ?>><?php echo str_repeat('-- ', $option['depth']) . $this->e($option['name']); ?></option>
                        <?php } ?>
                    </select>
                    <button type="submit" class="button"><?php echo T_('Move'); ?></button>
                </form>
                    <?php }
                    } ?>
            </td>
        </tr>
        <?php } ?>
        <?php if ($rows === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e(explode(' ', $column['class'])[0]); ?>"><?php echo ($column['footer']) ? $this->e($column['label']) : ''; ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php if ($browse->is_show_header()) {
    echo $this->raw((new ListHeaderView($browse, false, $argument_param))->render());
} ?>
