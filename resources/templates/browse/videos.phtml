// browse/videos.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\VideoListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\VideoListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$videos         = $this->getVideos();
if ($this->areRatingsShown()) {
    Rating::build_cache('video', $this->getObjectIds());
    Userflag::build_cache('video', $this->getObjectIds());
}

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="video">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=video&sort=' . $column['sort'], $column['label'], 'video_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($videos as $video) { ?>
        <tr id="video_<?php echo $this->e($video->id); ?>">
            <?php echo $this->raw($this->renderRow($video)); ?>
        </tr>
        <?php } ?>
        <?php if ($videos === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
