// browse/labels.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\LabelListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\LabelListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$labels         = $this->getLabels();

if ($this->mayCreate()) { ?>
<div id="information_actions">
    <ul>
        <li>
            <a href="<?php echo $this->e($this->getCreateUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('add_circle', T_('Add'))); ?>
                <?php echo T_('Create Label'); ?>
            </a>
        </li>
    </ul>
</div>
<?php }

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="label">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=label&sort=' . $column['sort'], $column['label'], 'label_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($labels as $label) { ?>
        <tr id="label_<?php echo $this->e($label->id); ?>">
            <?php echo $this->raw($this->renderRow($label)); ?>
        </tr>
        <?php } ?>
        <?php if ($labels === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php show_table_render();

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
