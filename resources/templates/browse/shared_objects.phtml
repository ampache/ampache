// browse/shared_objects.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\ShareListRenderer

use Ampache\Module\Api\Ajax;

/** @var Ampache\Gui\Browse\ListRenderer\ShareListRenderer $this */

// show_objects() closes the box itself, so this does not emit its own box bottom
$browse  = $this->getBrowse();
$columns = $this->getColumns();
$shares  = $this->getShares(); ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="share">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=share&sort=' . $column['sort'], $column['label'], 'share_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($shares as $share) { ?>
        <tr id="share_<?php echo $this->e($share->id); ?>">
            <?php echo $this->raw($this->renderRow($share)); ?>
        </tr>
        <?php } ?>
        <?php if ($shares === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
</table>
