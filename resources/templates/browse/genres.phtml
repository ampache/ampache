// browse/genres.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\GenreListRenderer

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\GenreListRenderer $this */

$browse  = $this->getBrowse();
$columns = $this->getColumns();
$genres  = $this->getGenres();
if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows" data-objecttype="tag">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($genres as $genre) { ?>
        <tr id="genre_<?php echo $this->e($genre->getId()); ?>">
            <?php echo $this->raw($this->renderRow($genre)); ?>
        </tr>
        <?php } ?>
        <?php if ($genres === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php show_table_render(); ?>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
