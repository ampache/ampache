// browse/song_previews.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\SongPreviewListRenderer

/** @var Ampache\Gui\Browse\ListRenderer\SongPreviewListRenderer $this */

// show_objects() closes the box itself, so this does not emit its own box bottom
$columns  = $this->getColumns();
$previews = $this->getPreviews(); ?>
<table class="tabledata striped-rows">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($previews as $preview) { ?>
        <tr id="song_preview_<?php echo $this->e($preview->id); ?>">
            <?php echo $this->raw($this->renderRow($preview)); ?>
        </tr>
        <?php } ?>
        <?php if ($previews === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
</table>
