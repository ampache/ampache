// browse/albums.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\AlbumListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\AlbumListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$albums         = $this->getAlbums();
$objectType     = $this->getObjectType();
$sortPrefix     = $this->getSortPrefix();
$sortUrl        = '?page=browse&action=set_sort&browse_id=' . $browse->id . '&sort=';
if ($this->showRatings()) {
    Rating::build_cache($objectType, $this->getObjectIds());
    Userflag::build_cache($objectType, $this->getObjectIds());
}

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="<?php echo $this->e($objectType); ?>">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text($sortUrl . $column['sort'], $column['label'], $sortPrefix . $column['key'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($albums as $album) { ?>
        <tr id="<?php echo $this->e($objectType . '_' . $album->getId()); ?>" class="libitem_menu" data-object-type="<?php echo $this->e($objectType); ?>" data-object-id="<?php echo $this->e($album->getId()); ?>">
            <?php echo $this->raw($this->renderRow($album)); ?>
        </tr>
        <?php } ?>
        <?php if ($albums === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e(explode(' ', $column['class'])[0]); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php show_table_render(); ?>
<?php if ($browse->is_show_header()) {
    $is_header = $this->getGroupRelease();
    $hide_view = $this->getGroupRelease();
    require Ui::find_template('list_header.inc.php');
} ?>
