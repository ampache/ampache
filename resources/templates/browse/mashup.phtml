// browse/mashup.phtml -- rendered by Ampache\Gui\Browse\MashupView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\MashupView $this */

echo $this->raw($this->getDashboardForm()->render());

foreach ($this->getSections() as $section => $objectIds) {
    if ($objectIds === []) {
        continue;
    }

    $url   = $this->getSectionUrl($section);
    $title = $this->getSectionTitle($section) . '&nbsp' . Ajax::button($this->getRefreshAction($section), 'refresh', T_('Refresh'), $section, 'dashboard_' . $section);
    if ($url !== null) {
        echo '<a href="' . $this->e($url) . '">';
    }

    Ui::show_box_top($title, $section);
    if ($url !== null) {
        echo '</a>';
    } ?>
<div id="dashboard_<?php echo $this->e($section); ?>">
<?php $browse = $this->createBrowse();
    $browse->set_type($this->getObjectType());
    $browse->set_use_filters(false);
    $browse->set_show_header(false);
    $browse->set_grid_view(true, false);
    $browse->set_mashup(true);
    $browse->show_objects($objectIds); ?>
</div>
<?php Ui::show_box_bottom();
}
