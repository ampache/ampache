// browse/broadcasts.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\BroadcastListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\BroadcastListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$broadcasts     = $this->getBroadcasts();

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<div class="browse_filters">
    <?php foreach ($this->getStartedFilters() as $filter) { ?>
    <a href="<?php echo $this->e($filter['url']); ?>" class="<?php echo $filter['current'] ? 'current' : ''; ?>"><?php echo $this->e($filter['label']); ?></a>
    <?php } ?>
</div>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="broadcast">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=broadcast&sort=' . $column['sort'], $column['label'], 'broadcast_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($broadcasts as $broadcast) { ?>
        <tr id="broadcast_row_<?php echo $this->e($broadcast->id); ?>">
            <?php echo $this->raw($this->renderRow($broadcast)); ?>
        </tr>
        <?php } ?>
        <?php if ($broadcasts === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
</table>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
