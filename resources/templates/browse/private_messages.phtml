// browse/private_messages.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\PrivateMessageListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\PrivateMessageListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$messages       = $this->getMessages();
$webPath        = $this->getWebPath(); ?>
<script>
    function getSelectionArray()
    {
        var checked = []
        $("input[name='pvmsg_select[]']:checked").each(function () {
            checked.push(parseInt($(this).val(), 10));
        });
        return checked.join(",");
    }
</script>
<div id="information_actions">
    <ul>
        <li><a href="<?php echo $this->e($webPath); ?>/pvmsg.php?action=show_add_message"><?php echo $this->raw(Ui::get_material_symbol('mail', T_('Compose'))); ?> <?php echo T_('Compose a New Message'); ?></a></li>
        <li><a href="javascript:NavigateTo('<?php echo $this->e($webPath); ?>/pvmsg.php?action=set_is_read&read=1&msgs=' + getSelectionArray());"><?php echo T_('Mark as Read'); ?></a></li>
        <li><a href="javascript:NavigateTo('<?php echo $this->e($webPath); ?>/pvmsg.php?action=set_is_read&read=0&msgs=' + getSelectionArray());"><?php echo T_('Mark as Unread'); ?></a></li>
        <li><a href="javascript:NavigateTo('<?php echo $this->e($webPath); ?>/pvmsg.php?action=delete&msgs=' + getSelectionArray());"><?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?> <?php echo T_('Delete'); ?></a></li>
    </ul>
</div>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="pvmsg">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=pvmsg&sort=' . $column['sort'], $column['label'], 'pvmsg_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($messages as $message) { ?>
        <tr id="pvmsg_<?php echo $this->e($message->getId()); ?>" class="<?php echo $message->isRead() ? '' : 'unread'; ?>">
            <?php echo $this->raw($this->renderRow($message)); ?>
        </tr>
        <?php } ?>
        <?php if ($messages === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php show_table_render();

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
