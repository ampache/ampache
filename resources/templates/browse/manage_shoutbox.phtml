// browse/manage_shoutbox.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\ShoutboxListRenderer

/** @var Ampache\Gui\Browse\ListRenderer\ShoutboxListRenderer $this */

$columns = $this->getColumns();
$rows    = $this->getRows(); ?>
<table class="tabledata striped-rows">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($rows as $row) {
            echo $this->raw($this->renderRow($row));
        } ?>
        <?php if ($rows === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>" class="error"><?php echo T_('Found nothing to show'); ?></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
