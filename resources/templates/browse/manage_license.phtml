// browse/manage_license.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\LicenseListRenderer

/** @var Ampache\Gui\Browse\ListRenderer\LicenseListRenderer $this */

$columns  = $this->getColumns();
$licenses = $this->getLicenses();
$toggle   = $this->getToggle(); ?>
<div id="information_actions">
    <ul>
        <li>
            <a href="<?php echo $this->e($this->getCreateUrl()); ?>"><?php echo T_('Create License'); ?></a>
        </li>
        <li>
            <a href="<?php echo $this->e($toggle['url']); ?>"><?php echo $this->e($toggle['label']); ?></a>
        </li>
    </ul>
</div>
<table class="tabledata striped-rows">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($licenses as $license) {
            echo $this->raw($this->renderRow($license));
        } ?>
        <?php if ($licenses === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>" class="error"><?php echo T_('Found nothing to show'); ?></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
