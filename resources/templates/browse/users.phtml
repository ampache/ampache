// browse/users.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\UserListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\UserListRenderer $this */

$browse  = $this->getBrowse();
$columns = $this->getColumns();
$users   = $this->getUsers();
$type    = $browse->get_type();
if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="user">
    <colgroup>
        <?php foreach ($columns as $column) { ?>
        <col id="col_<?php echo $this->e(substr(explode(' ', $column['class'])[0], 4)); ?>" />
        <?php } ?>
    </colgroup>
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=' . $type . '&sort=' . $column['sort'], $column['label'], 'users_sort_' . $column['sort'])); ?><?php
                if ($column['sort'] === 'username') {
                    echo ' ' . $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=' . $type . '&sort=fullname', '(' . T_('Fullname') . ')', 'users_sort_fullname'));
                } ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($users as $user) { ?>
        <tr id="admin_user_<?php echo $this->e($user->getId()); ?>">
            <?php echo $this->raw($this->renderRow($user)); ?>
        </tr>
        <?php } ?>
        <?php if ($users === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('No User found'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e(explode(' ', $column['class'])[0]); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
