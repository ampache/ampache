// browse/collections.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\CollectionListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\CollectionListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$collections    = $this->getCollections();
$sortUrl        = '?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=collection&sort=';
if ($this->showRatings()) {
    Rating::build_cache('collection', $this->getObjectIds());
    Userflag::build_cache('collection', $this->getObjectIds());
}

if ($this->mayCreate()) { ?>
<div id="information_actions">
    <ul>
        <li>
            <a href="<?php echo $this->e($this->getCreateUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('add_circle', T_('Create Collection'))); ?>
                <?php echo T_('Create Collection'); ?>
            </a>
        </li>
    </ul>
</div>
<?php }

if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="collection">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text($sortUrl . $column['sort'], $column['label'], 'collection_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($collections as $collection) { ?>
        <tr id="collection_row_<?php echo $this->e($collection->getId()); ?>" class="libitem_menu" data-object-type="collection" data-object-id="<?php echo $this->e($collection->getId()); ?>">
            <?php echo $this->raw($this->renderRow($collection)); ?>
        </tr>
        <?php } ?>
        <?php if ($collections === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e(explode(' ', $column['class'])[0]); ?>"><?php echo ($column['header']) ? $this->e($column['label']) : ''; ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php show_table_render(); ?>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
