// browse/folders.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\FolderListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\FolderListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$rows           = $this->getRows();
if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<form method="post" id="reorder_folder_<?php echo $this->e($this->getParentFolder()->getId()); ?>">
    <table class="tabledata striped-rows<?php echo $this->e($this->getTableClass()); ?>" data-objecttype="folder">
        <thead>
            <tr class="th-top">
                <?php foreach ($columns as $column) { ?>
                <th class="<?php echo $this->e($column['class']); ?>"><?php
                    echo ($column['sort'] === null)
                        ? $this->e($column['label'])
                        : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&sort=' . $column['sort'], $column['label'], 'folder_sort_' . $column['sort'])); ?></th>
                <?php } ?>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($rows as $row) { ?>
            <tr id="<?php echo $this->e($row['type'] . '_' . $row['item']->getId()); ?>" class="libitem_menu" data-object-type="<?php echo $this->e($row['type']); ?>" data-object-id="<?php echo $this->e($row['item']->getId()); ?>">
                <?php echo $this->raw($this->renderRow($row['item'], $row['type'])); ?>
            </tr>
            <?php } ?>
            <?php if ($rows === []) { ?>
            <tr>
                <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
            </tr>
            <?php } ?>
        </tbody>
        <tfoot>
            <tr class="th-bottom">
                <?php foreach ($columns as $column) { ?>
                <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
                <?php } ?>
            </tr>
        </tfoot>
    </table>
</form>
<?php show_table_render(); ?>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
