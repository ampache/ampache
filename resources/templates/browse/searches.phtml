// browse/searches.phtml -- rendered by Ampache\Gui\Browse\ListRenderer\SmartPlaylistListRenderer

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Browse\ListRenderer\SmartPlaylistListRenderer $this */

$browse         = $this->getBrowse();
$argument_param = $this->getArgumentParam();
$columns        = $this->getColumns();
$searches       = $this->getSearches();
if ($this->areRatingsShown()) {
    Rating::build_cache('search', $this->getObjectIds());
    Userflag::build_cache('search', $this->getObjectIds());
} ?>
<div id="information_actions">
    <ul>
        <?php if ($this->mayCreate()) { ?>
        <li>
            <a href="<?php echo $this->e($this->getCreateUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('add_circle', T_('Add'))); ?>
                <?php echo T_('Add Smart Playlist'); ?>
            </a>
        </li>
        <?php } ?>
    </ul>
</div>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
<table class="tabledata striped-rows <?php echo $this->e($browse->get_css_class()); ?>" data-objecttype="smartplaylist">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php
                echo ($column['sort'] === null)
                    ? $this->e($column['label'])
                    : $this->raw(Ajax::text('?page=browse&action=set_sort&browse_id=' . $browse->id . '&type=smartplaylist&sort=' . $column['sort'], $column['label'], 'playlist_sort_' . $column['sort'])); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($searches as $search) { ?>
        <tr id="smartplaylist_row_<?php echo $this->e($search->id); ?>">
            <?php echo $this->raw($this->renderRow($search)); ?>
        </tr>
        <?php } ?>
        <?php if ($searches === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('No smart playlist found'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<?php if ($browse->is_show_header()) {
    require Ui::find_template('list_header.inc.php');
} ?>
