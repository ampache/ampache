// install/install_language.phtml -- rendered by Ampache\Gui\Install\InstallLanguageView

use Ampache\Module\System\AmpError;

/** @var Ampache\Gui\Install\InstallLanguageView $this */
?>
<?php echo $this->raw($this->renderHeader()); ?>
        <!-- Main jumbotron for a primary marketing message or call to action -->
        <br><br>
        <div class="page-header">
            <h1><?php echo $this->e(T_('Choose Installation Language')); ?></h1>
        </div>
        <p><?php echo $this->raw(AmpError::display('general')); ?></p>
        <form role="form" method="post" action="<?php echo $this->e($this->getWebPath()) . "/install.php?action=check"; ?>" enctype="multipart/form-data" >
            <div class="row mb-3">
        <?php // the locale names arrive as html entities, which survive whatever charset the installer is set to?>
        <select class="form-control" name="htmllang">
        <?php foreach ($this->getLanguages() as $lang => $name) { ?>
            <option value="<?php echo $this->e($lang); ?>"<?php echo ($this->isSelected($lang)) ? ' selected="selected"' : ''; ?>><?php echo $this->raw($name); ?></option>
        <?php } ?>
        </select>
            </div>
            <button type="submit" class="btn btn-warning"><?php echo $this->e(T_('Start Configuration')); ?></button>
        </form>
<?php echo $this->raw($this->renderFooter()); ?>
