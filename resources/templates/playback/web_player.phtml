                autoPlay: <?php echo ($this->autoplays()) ? 'true' : 'false'; ?>,
                removePlayed: <?php echo ($this->removesPlayed()) ? 'true' : 'false'; ?>, // remove tracks before the current playlist item
                removeCount: <?php echo $this->getRemoveCount(); ?>, // shift the index back to keep x items BEFORE the current index
                loopBack: false, // repeat a finished playlist from the start
                shuffleOnLoop: false,
                enableRemoveControls: <?php echo ($this->isShare()) ? 'false' : 'true'; ?>,
                displayTime: 'slow',
