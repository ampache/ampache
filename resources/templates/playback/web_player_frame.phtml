// playback/web_player_frame.phtml -- rendered by Ampache\Gui\Playback\WebPlayerFrameView

use Ampache\Module\Playback\WebPlayer;

/** @var Ampache\Gui\Playback\WebPlayerFrameView $this */
?>
<!DOCTYPE html>
<html>
<head>
<title><?php echo $this->e($this->getSiteTitle()); ?></title>
<script>
function PlayerFrame()
{
    var appendmedia = false;
    var playnext = false;
    var webplayer = $("#webplayer");
    if (webplayer.is(':visible')) {
<?php if ($this->appendsMedia()) { ?>
        appendmedia = true;
<?php } elseif ($this->playsNext()) { ?>
        playnext = true;
<?php } ?>
    }

<?php if ($this->clearsBeforeUnload()) { ?>
    document.onbeforeunload = null;
<?php } ?>
    if (appendmedia) {
        <?php echo $this->raw(WebPlayer::add_media_js($this->getPlaylist())); ?>
    } else if (playnext) {
        <?php echo $this->raw(WebPlayer::play_next_js($this->getPlaylist())); ?>
    } else {
        webplayer.show();
        $("#webplayer-minimize").show();
        $.get('<?php echo $this->e($this->getEmbedUrl()); ?>', function (data) {
            var $response = $(data);
            webplayer.empty().append($response);
        }, 'html');
    }
    return false;
}

PlayerFrame();
</script>
</head>
<body>
</body>
</html>
