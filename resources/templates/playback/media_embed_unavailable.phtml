// playback/media_embed_unavailable.phtml -- rendered by Ampache\Gui\Playback\MediaEmbedUnavailableView

/** @var Ampache\Gui\Playback\MediaEmbedUnavailableView $this */

$logo = $this->getLogoUrl(); ?>
<!DOCTYPE html>
<html lang="<?php echo $this->e($this->getDocumentLanguage()); ?>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title><?php echo $this->e($this->getSiteTitle()); ?></title>
<style>
    /* self-contained: this page is framed by a site whose stylesheet is none of our business */
    * { box-sizing: border-box; }
    body { margin: 0; font: 13px/1.4 system-ui, sans-serif; color: #eee; background: #1b1b1b; }
    /* the frame was sized by the card a scraper stored, so this has to sit right at 128 and at 340 */
    .gone { display: flex; gap: 12px; align-items: center; justify-content: center; height: 100vh; padding: 10px; }
    .gone img { width: 48px; height: 48px; object-fit: contain; flex: none; }
    .gone .name { font-weight: 600; }
    .gone .meta { min-width: 0; }
    .gone p { margin: 0; }
    .gone .away { color: #aaa; }
    .gone a { color: inherit; }
    .gone a:hover, .gone a:focus { text-decoration: none; }
</style>
</head>
<body>
<div class="gone">
    <?php if ($logo !== '') { ?>
    <img src="<?php echo $this->e($logo); ?>" alt="">
    <?php } ?>
    <div class="meta">
        <p class="name"><?php echo T_('This player is no longer available'); ?></p>
        <p class="away">
            <a href="<?php echo $this->e($this->getLinkUrl()); ?>" target="_blank" rel="noopener">
                <?php printf(
                    /* HINT: name of this Ampache server */
                    T_('Open on %s'),
                    $this->e($this->getSiteTitle())
                ); ?> &rarr;
            </a>
        </p>
    </div>
</div>
</body>
</html>
