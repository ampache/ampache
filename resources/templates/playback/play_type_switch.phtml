// playback/play_type_switch.phtml -- rendered by Ampache\Gui\Playback\PlayTypeSwitchView

use Ampache\Module\Api\Ajax;

/** @var Ampache\Gui\Playback\PlayTypeSwitchView $this */

$current = $this->getCurrent(); ?>
<div id="play_type_switch">
    <?php if ($this->mayChange()) { ?>
    <form method="post" id="play_type_form" action="javascript.void(0);">
        <select id="play_type_select" name="type">
            <?php foreach ($this->getOptions() as $option) { ?>
            <option value="<?php echo $this->e($option['value']); ?>"<?php echo ($option['value'] === $current) ? ' selected="selected"' : ''; ?>><?php echo $this->e($option['label']); ?></option>
            <?php } ?>
        </select>
        <?php echo $this->raw(Ajax::observe('play_type_select', 'change', Ajax::action('?page=stream&action=set_play_type', 'play_type_select', 'play_type_form'))); ?>
    </form>
    <?php } else {
        echo $this->e($this->getCurrentLabel());
    } ?>
</div>
