// collection.phtml -- rendered by Ampache\Gui\Collection\CollectionViewAdapter in its own scope

use Ampache\Module\Api\RefreshReordered\RefreshCollectionItemsAction;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Collection\CollectionViewAdapter $this */

Ui::show_box_top('<div id="collection_row_' . $this->getId() . '">' . $this->e($this->getName()) . '</div>', 'info-box'); ?>
<div class="item_right_info">
<?php $this->getCollection()->display_art($this->getArtSize(), false, false); ?>
</div>
<?php if ($this->isRatingsEnabled()) { ?>
<span id="rating_<?php echo $this->getId(); ?>_collection">
    <?php echo $this->raw($this->getRating()); ?>
</span>
<span id="userflag_<?php echo $this->getId(); ?>_collection">
    <?php echo $this->raw($this->getUserFlags()); ?>
</span>
<?php } ?>
<div id="information_actions">
    <ul>
        <li>
            <?php echo T_('Owner'); ?>: <?php echo $this->e($this->getOwner()); ?>
        </li>
        <li>
            <?php echo T_('Type'); ?>:
            <?php echo $this->e($this->getTypeLabel()); ?>
        </li>
<?php if ($this->canDirectPlay()) { ?>
        <li>
            <?php echo $this->raw($this->getDirectplayButton()); ?>
        </li>
<?php }
if ($this->canPlayNext()) { ?>
        <li>
            <?php echo $this->raw($this->getPlayNextButton()); ?>
        </li>
<?php }
if ($this->canPlayAppend()) { ?>
        <li>
            <?php echo $this->raw($this->getPlayLastButton()); ?>
        </li>
<?php }
if ($this->canEdit()) { ?>
        <li>
            <a id="<?php echo 'edit_collection_' . $this->getId(); ?>" onclick="showEditDialog('collection_row', '<?php echo $this->getId(); ?>', '<?php echo 'edit_collection_' . $this->getId(); ?>', '<?php echo $this->raw($this->getEditDialogTitle()); ?>', '')">
                <?php echo $this->raw($this->getEditIcon()); ?>
                <?php echo T_('Edit'); ?>
            </a>
        </li>
<?php }
if ($this->canReorder()) { ?>
        <li>
            <?php // Confirmed first: the link sits next to Edit and Delete, and a stray click would overwrite the
            // stored order with whatever the page happens to be showing. `data-confirm` is no use here because an
            // inline onclick fires before the delegated handler can intercept it.?>
            <a onclick="window.ampacheConfirm('<?php echo $this->raw($this->getReorderConfirmation()); ?>').then(function (ok) { if (ok) { submitNewItemsOrder('<?php echo $this->getId(); ?>', 'reorder_collection_table', 'track_', '<?php echo $this->getTrackNumbersUrl(); ?>', '<?php echo RefreshCollectionItemsAction::REQUEST_KEY; ?>'); } })">
                <?php echo $this->raw($this->getReorderIcon());
    echo "&nbsp;" . T_('Save Track Order'); ?>
            </a>
        </li>
<?php }
if ($this->canDelete()) { ?>
        <li>
            <a href="<?php echo $this->getDeletionUrl(); ?>" data-confirm="<?php echo $this->e($this->getDeletionConfirmation()); ?>">
                <?php echo $this->raw($this->getDeletionIcon()); ?>
                <?php echo T_('Delete'); ?>
            </a>
        </li>
<?php } ?>
    </ul>
</div>
<?php Ui::show_box_bottom(); ?>
<?php if ($this->isEmpty()) { ?>
    <p><?php echo T_('This Collection is empty'); ?></p>
<?php } else {
    $pinnedType = $this->getPinnedBrowseType();
    $browse     = $this->createBrowse();

    if ($pinnedType !== null) {
        // Every member shares one type, so that type's own browse can render it the way it always does
        $browse->set_type($pinnedType);
        $browse->show_objects($this->getMemberIds());
        $browse->store();
    } else { ?>
<div id="reordered_list_<?php echo $this->getId(); ?>">
<?php
        // Mixed, so the members stay in one list in curated order and each row names its own type. The second
        // argument turns the drag handling on, the same flag a playlist passes.
        $browse->set_type('collection_items');
        $browse->add_supplemental_object('collection', $this->getCollection());
        $browse->show_objects($this->getObjectIds(), true);
        $browse->store(); ?>
</div>
<?php }
    } ?>
