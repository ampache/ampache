// search/options.phtml -- rendered by Ampache\Gui\Search\SearchOptionsView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Search\SearchOptionsView $this */

$browseId = $this->getBrowseId();
Ui::show_box_top(T_('Options'), 'info-box'); ?>
<div id="information_actions">
    <ul>
        <?php if ($this->isPlayable()) { ?>
        <?php if ($this->isDirectPlay()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=browse&object_id=' . $browseId, 'play_circle', T_('Play'), 'play_browse_browse_' . $browseId)); ?></li>
        <?php if ($this->isAutoplayNext()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=browse&object_id=' . $browseId . '&playnext=true', 'menu_open', T_('Play next'), 'nextplay_browse_' . $browseId)); ?></li>
        <?php } ?>
        <?php if ($this->isAutoplayAppend()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=browse&object_id=' . $browseId . '&append=true', 'low_priority', T_('Play last'), 'addplay_browse_' . $browseId)); ?></li>
        <?php } ?>
        <?php } ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?action=basket&type=browse_set&browse_id=' . $browseId, 'new_window', T_('Add to Temporary Playlist'), 'add_search_results')); ?></li>
        <li><?php echo $this->raw(Ajax::button_with_text('?action=basket&type=browse_set_random&browse_id=' . $browseId, 'shuffle', T_('Random to Temporary Playlist'), 'add_search_results_random')); ?></li>
        <?php } ?>
        <?php if ($this->mayBatchDownload()) { ?>
        <li>
            <a class="nohtml" href="<?php echo $this->e($this->getWebPath()); ?>/batch.php?action=browse&type=<?php echo $this->e($this->getSearchType()); ?>&browse_id=<?php echo $browseId; ?>" rel="nofollow">
                <?php echo $this->raw(Ui::get_material_symbol('folder_zip', T_('Batch download'))); ?>
                <?php echo T_('Batch download'); ?>
            </a>
        </li>
        <?php } ?>
    </ul>
</div>
<?php Ui::show_box_bottom(); ?>
