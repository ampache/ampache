// album/album.phtml -- rendered by Ampache\Gui\Album\AlbumPageView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Api\RefreshReordered\RefreshAlbumSongsAction;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Rss\Type\RssFeedTypeEnum;
use Ampache\Module\Util\Ui;
use Ampache\Repository\Model\Share;

/** @var Ampache\Gui\Album\AlbumPageView $this */

$albumId = $this->getAlbumId();
$webPath = $this->getWebPath();
Ui::show_box_top($this->getTitle(), 'info-box'); ?>
<div class="item_right_info">
    <?php echo $this->raw($this->getExternalLinks()->render()); ?>
    <?php echo $this->raw($this->getArt()); ?>
</div>
<?php if ($this->showRatings()) { ?>
<span id="rating_<?php echo $albumId; ?>_album"><?php echo $this->raw(Rating::show($albumId, 'album', true)); ?></span>
<span id="userflag_<?php echo $albumId; ?>_album"><?php echo $this->raw(Userflag::show($albumId, 'album')); ?></span>
<?php } ?>
<?php if ($this->showPlayedTimes()) { ?>
<br />
<div style="display:inline;">
    <?php /* HINT: Number of times an object has been played */
    echo T_('Played') . ' ' . sprintf(nT_('%d time', '%d times', $this->getPlayedTimes()), $this->getPlayedTimes()); ?>
</div>
<?php } ?>
<?php if ($this->showUploader()) { ?>
<div class="item_uploaded_by">
    <?php echo T_('Uploaded by'); ?> <?php echo $this->raw($this->getOwner()?->get_f_link() ?? ''); ?>
</div>
<?php } ?>
<div id="information_actions">
    <h3><?php echo T_('Actions'); ?></h3>
    <ul>
        <?php if ($this->showDirectPlay()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=album&object_id=' . $albumId, 'play_circle', T_('Play'), 'directplay_full_' . $albumId)); ?></li>
        <?php if ($this->isAutoplayNext()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=album&object_id=' . $albumId . '&playnext=true', 'menu_open', T_('Play next'), 'nextplay_album_' . $albumId)); ?></li>
        <?php } ?>
        <?php if ($this->isAutoplayAppend()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=album&object_id=' . $albumId . '&append=true', 'low_priority', T_('Play last'), 'addplay_album_' . $albumId)); ?></li>
        <?php } ?>
        <?php } ?>
        <?php if ($this->showAdd()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?action=basket&type=album&id=' . $albumId, 'new_window', T_('Add to Temporary Playlist'), 'play_full_' . $albumId)); ?></li>
        <li><?php echo $this->raw(Ajax::button_with_text('?action=basket&type=album_random&id=' . $albumId, 'shuffle', T_('Random to Temporary Playlist'), 'play_random_' . $albumId)); ?></li>
        <li>
            <a id="add_to_playlist_<?php echo $albumId; ?>" onclick="showPlaylistDialog(event, 'album', '<?php echo $albumId; ?>')">
                <?php echo $this->raw(Ui::get_material_symbol('playlist_add', $this->getAddToListLabel())); ?>
                <?php echo $this->e($this->getAddToListLabel()); ?>
            </a>
        </li>
        <?php } ?>
        <?php if ($this->showRss()) { ?>
        <li><?php echo $this->raw(Ui::getRssLink(RssFeedTypeEnum::LIBRARY_ITEM, $this->getUser(), T_('RSS Feed'), ['object_type' => 'album', 'object_id' => (string) $albumId])); ?></li>
        <?php } ?>
        <?php if ($this->showShout()) { ?>
        <li>
            <a href="<?php echo $this->e($webPath); ?>/shout.php?action=show_add_shout&type=album&id=<?php echo $albumId; ?>">
                <?php echo $this->raw(Ui::get_material_symbol('comment', T_('Post Shout'))); ?>&nbsp;<?php echo T_('Post Shout'); ?>
            </a>
        </li>
        <?php } ?>
        <?php if ($this->showShare()) { ?>
        <li><?php echo $this->raw(Share::display_ui('album', $albumId)); ?></li>
        <?php } else { ?>
        <li>
            <a href="<?php echo $this->e($this->getLink()); ?>" target="_blank">
                <?php echo $this->raw(Ui::get_material_symbol('open_in_new', T_('Link'))); ?>&nbsp;<?php echo T_('Link'); ?>
            </a>
        </li>
        <?php } ?>
        <?php if ($this->mayManage()) { ?>
        <?php if ($this->showGraphs()) { ?>
        <li>
            <a href="<?php echo $this->e($webPath); ?>/stats.php?action=graph&object_type=album&object_id=<?php echo $albumId; ?>">
                <?php echo $this->raw(Ui::get_material_symbol('bar_chart', T_('Graphs'))); ?><?php echo T_('Graphs'); ?>
            </a>
        </li>
        <?php } ?>
        <li>
            <a onclick="submitNewItemsOrder('<?php echo $albumId; ?>', 'reorder_songs_table_<?php echo $albumId; ?>', 'song_', '<?php echo $this->e($webPath); ?>/albums.php?action=set_track_numbers', '<?php echo $this->e(RefreshAlbumSongsAction::REQUEST_KEY); ?>')">
                <?php echo $this->raw(Ui::get_material_symbol('save', T_('Save Track Order'))); ?>
                <?php echo T_('Save Track Order'); ?>
            </a>
        </li>
        <li>
            <a href="javascript:NavigateTo('<?php echo $this->e($webPath); ?>/albums.php?action=update_from_tags&album_id=<?php echo $albumId; ?>');" data-confirm="<?php echo $this->e(T_('Do you really want to update from tags?')); ?>">
                <?php echo $this->raw(Ui::get_material_symbol('sync_alt', T_('Update from tags'))); ?>&nbsp;<?php echo T_('Update from tags'); ?>
            </a>
        </li>
        <?php } ?>
        <?php if ($this->isEditable()) { ?>
        <?php if ($this->mayUpload()) { ?>
        <li>
            <a href="<?php echo $this->e($webPath); ?>/upload.php?artist=<?php echo $this->e($this->getArtistId()); ?>&album=<?php echo $albumId; ?>">
                <?php echo $this->raw(Ui::get_material_symbol('upload', T_('Upload'))); ?>&nbsp;<?php echo T_('Upload'); ?>
            </a>
        </li>
        <?php } ?>
        <li>
            <a id="edit_album_<?php echo $albumId; ?>" onclick="showEditDialog('album_row', '<?php echo $albumId; ?>', 'edit_album_<?php echo $albumId; ?>', '<?php echo addslashes(T_('Album Edit')); ?>', '')">
                <?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?>&nbsp;<?php echo T_('Edit Album'); ?>
            </a>
        </li>
        <?php } ?>
        <?php if ($this->mayZip()) { ?>
        <li>
            <a class="nohtml" href="<?php echo $this->e($webPath); ?>/batch.php?action=album&id=<?php echo $albumId; ?>" rel="nofollow">
                <?php echo $this->raw(Ui::get_material_symbol('folder_zip', T_('Download'))); ?>&nbsp;<?php echo T_('Download'); ?>
            </a>
        </li>
        <?php } ?>
        <?php if ($this->mayDelete()) { ?>
        <li>
            <a id="delete_album_<?php echo $albumId; ?>" href="<?php echo $this->e($webPath); ?>/albums.php?action=delete&album_id=<?php echo $albumId; ?>">
                <?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?>
                <?php echo T_('Delete'); ?>
            </a>
        </li>
        <?php } ?>
    </ul>
</div>
<?php Ui::show_box_bottom(); ?>
<div id="additional_information">&nbsp;</div>
<div id="reordered_list_<?php echo $albumId; ?>">
<?php $browse = $this->createBrowse();
$browse->set_type('song');
$browse->set_simple_browse(true);
$browse->set_skip_catalog_check(true);
$browse->set_limit(0);
$browse->set_offset(0);
$browse->set_sort('track', 'ASC', false);
$browse->set_filter('album', $albumId);
$browse->show_objects([], ['hide' => $this->getHiddenColumns()]);
$browse->store(); ?>
</div>
