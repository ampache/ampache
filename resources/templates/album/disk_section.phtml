// album/disk_section.phtml -- rendered by Ampache\Gui\Album\AlbumDiskSectionView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;
use Ampache\Repository\Model\Share;

/** @var Ampache\Gui\Album\AlbumDiskSectionView $this */

$diskId  = $this->getDiskId();
$webPath = $this->getWebPath(); ?>
<div class="album_group_disks_title"><span><?php echo $this->raw($this->getSubtitle()); ?></span></div>
<div class="album_group_disks_actions">
    <?php if ($this->showDirectPlay()) {
        echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=album_disk&object_id=' . $diskId, 'play_circle', T_('Play'), 'directplay_full_' . $diskId));
        if ($this->isAutoplayNext()) {
            echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=album_disk&object_id=' . $diskId . '&playnext=true', 'menu_open', T_('Play next'), 'nextplay_album_disk_' . $diskId));
        }

        if ($this->isAutoplayAppend()) {
            echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=album_disk&object_id=' . $diskId . '&append=true', 'low_priority', T_('Play last'), 'addplay_album_disk_' . $diskId));
        }
    }

if ($this->showAdd()) {
    echo $this->raw(Ajax::button('?action=basket&type=album_disk&id=' . $diskId, 'new_window', T_('Add to Temporary Playlist'), 'play_full_' . $diskId));
    echo $this->raw(Ajax::button('?action=basket&type=album_disk_random&id=' . $diskId, 'shuffle', T_('Random to Temporary Playlist'), 'play_random_' . $diskId));
} ?>
    <?php if ($this->showShout()) { ?>
    <a href="<?php echo $this->e($webPath); ?>/shout.php?action=show_add_shout&type=album_disk&id=<?php echo $diskId; ?>"><?php echo $this->raw(Ui::get_material_symbol('comment', T_('Post Shout'))); ?></a>
    <?php } ?>
    <?php if ($this->showShare()) {
        echo $this->raw(Share::display_ui('album_disk', $diskId, false));
    } else { ?>
    <a href="<?php echo $this->e($this->getLink()); ?>" target="_blank">
        <?php echo $this->raw(Ui::get_material_symbol('open_in_new', T_('Link'))); ?>&nbsp;<?php echo T_('Link'); ?>
    </a>
    <?php } ?>
    <?php if ($this->isEditable()) { ?>
    <a id="edit_album_disk_<?php echo $diskId; ?>" onclick="showEditDialog('album_disk_row', '<?php echo $diskId; ?>', 'edit_album_disk_<?php echo $diskId; ?>', '<?php echo addslashes(T_('Album Edit')); ?>', '')">
        <?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?>
    </a>
    <?php } ?>
    <?php if ($this->mayZip()) { ?>
    <a class="nohtml" rel="nofollow" href="<?php echo $this->e($webPath); ?>/batch.php?action=album_disk&id=<?php echo $diskId; ?>"><?php echo $this->raw(Ui::get_material_symbol('folder_zip', T_('Download'))); ?></a>
    <?php } ?>
</div>
<div id="reordered_list_<?php echo $diskId; ?>">
<?php $browse = $this->createBrowse();
$browse->set_show_header(false);
$browse->set_type('song');
$browse->set_simple_browse(true);
$browse->set_skip_catalog_check(true);
$browse->set_limit(0);
$browse->set_offset(0);
$browse->set_sort('track', 'ASC', false);
$browse->set_filter('album_disk', $diskId);
$browse->show_objects([], ['hide' => $this->getHiddenColumns()]);
$browse->store(); ?>
</div><br />
