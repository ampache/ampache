// pow/challenge.phtml -- rendered by Ampache\Gui\Pow\PowChallengeView

use Ampache\Gui\Asset\StylesheetsView;

/** @var Ampache\Gui\Pow\PowChallengeView $this */
?>
<!DOCTYPE html>
<html lang="<?php echo $this->e($this->getDocumentLanguage()); ?>">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=<?php echo $this->e($this->getSiteCharset()); ?>" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title><?php echo $this->e($this->getTitle()); ?></title>
    <?php echo $this->raw((new StylesheetsView($this->getWebPath()))->render()); ?>
    <style>
        /* Self-contained so the page looks right whatever theme is installed. */
        #powPage {
            background-color: #000;
            color: #ddd;
        }

        #powbox {
            max-width: 34em;
            margin: 4vh auto;
            padding: 0 1em 2em;
            text-align: center;
        }

        #pow-canvas {
            display: block;
            width: 100%;
            height: min(60vh, 26em);
            background-color: #000;
            pointer-events: none;
        }

        #powbox .pow-status {
            font-variant-numeric: tabular-nums;
            letter-spacing: .04em;
            opacity: .75;
        }

        #powbox .pow-explain {
            opacity: .5;
            font-size: .9em;
        }
    </style>
</head>

<body id="powPage">
    <div id="powbox">
        <h2><?php echo $this->e(T_('Checking your browser')); ?></h2>

        <!-- The canvas is what turns the wait into something to look at; the check itself runs
             perfectly well without it, which is why the script treats it as optional. -->
        <canvas id="pow-canvas"></canvas>

        <!-- Solved by the widget script, which then submits this form and lets the original request
             resume. A GET form replaces the query string of its action, so the parameters of the
             interrupted request are carried over as fields. -->
        <form id="pow-form" method="get" action="<?php echo $this->e($this->getTargetPath()); ?>" data-pow-autosubmit="1">
            <?php foreach ($this->getTargetFields() as $field) { ?>
                <input type="hidden" name="<?php echo $this->e($field['name']); ?>" value="<?php echo $this->e($field['value']); ?>" />
            <?php } ?>
            <?php echo $this->raw($this->renderWidget()); ?>
            <noscript>
                <input type="submit" value="<?php echo $this->e(T_('Continue')); ?>" disabled />
            </noscript>
        </form>

        <p class="pow-explain"><?php echo $this->e(T_('This link is rate limited. Your download will start on its own.')); ?></p>
    </div>
</body>

</html>
