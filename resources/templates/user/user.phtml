// user/user.phtml -- rendered by Ampache\Gui\User\UserPageView

use Ampache\Gui\Stats\RecentlyPlayedMode;
use Ampache\Gui\Stats\RecentlyPlayedView;
use Ampache\Module\Statistics\Stats;
use Ampache\Module\Util\Ui;
use Ampache\Repository\Model\Song;

/** @var Ampache\Gui\User\UserPageView $this */

$clientId   = $this->getClientId();
$webPath    = $this->getWebPath();
$adminPath  = $this->getAdminPath();
$mayUpload  = $this->mayUpload();
$isSociable = $this->showSociable();
Ui::show_box_top($this->e($this->getFullname())); ?>
<?php if ($clientId > 0) { ?>
<div class="user_avatar">
    <?php echo $this->raw($this->getAvatar()); ?>
    <br /><br />
    <?php if ($isSociable) {
        echo $this->raw($this->getFollowState()); ?>
    <ul id="plugins_user_field">
        <?php foreach ($this->getPluginFields() as $field) { ?>
        <li><?php echo $this->raw($field); ?> </li>
        <?php } ?>
    </ul>
    <?php } ?>
</div>
<dl class="media_details">
    <dt><?php echo T_('Display Name'); ?></dt>
    <dd>
        <?php echo $this->e($this->getFullname()); ?>
        <?php if ($this->mayUse() && $isSociable) { ?>
        <a id="reply_pvmsg_<?php echo $clientId; ?>" href="<?php echo $this->e($webPath); ?>/pvmsg.php?action=show_add_message&to_user=<?php echo $this->e(urlencode($this->getUsername())); ?>">
            <?php echo $this->raw(Ui::get_material_symbol('mail', T_('Send private message'))); ?>
        </a>
        <?php } ?>
        <?php if ($this->isAdmin()) { ?>
        <a href="<?php echo $this->e($adminPath); ?>/users.php?action=show_edit&user_id=<?php echo $clientId; ?>"><?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?></a>
        <a href="<?php echo $this->e($adminPath); ?>/users.php?action=show_preferences&user_id=<?php echo $clientId; ?>"><?php echo $this->raw(Ui::get_material_symbol('page_info', T_('Preferences'))); ?></a>
        <?php } elseif ($this->isSelf()) { ?>
        <a href="<?php echo $this->e($webPath); ?>/preferences.php?tab=account"><?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?></a>
        <?php } ?>
        <?php if ($this->showNowPlaying()) { ?>
        <a href="<?php echo $this->e($webPath); ?>/now_playing.php?user_id=<?php echo $clientId; ?>" target="_blank"><?php echo $this->raw(Ui::get_material_symbol('headphones', T_('Now Playing'))); ?></a>
        <?php } ?>
        <?php if ($this->showWrapped()) { ?>
        <a href="<?php echo $this->e($webPath); ?>/mashup.php?action=wrapped&user_id=<?php echo $clientId; ?>&year=<?php echo $this->e($this->getWrappedYear()); ?>" target="_blank"><?php echo $this->raw(Ui::get_material_symbol('featured_seasonal_and_gifts', T_('Wrapped'))); ?></a>
        <?php } ?>
    </dd>
    <dt><?php echo T_('Member Since'); ?></dt>
    <dd><?php echo $this->e($this->getCreateDate()); ?></dd>
    <dt><?php echo T_('Last Seen'); ?></dt>
    <dd><?php echo $this->e($this->getLastSeen()); ?></dd>
    <?php if ($this->mayManage()) { ?>
    <dt><?php echo T_('Activity'); ?></dt>
    <dd><?php echo $this->e($this->getUsage()); ?>
        <?php if ($this->showGraphs()) { ?>
        <a href="<?php echo $this->e($webPath); ?>/stats.php?action=graph&user_id=<?php echo $clientId; ?>"><?php echo $this->raw(Ui::get_material_symbol('bar_chart', T_('Graphs'))); ?></a>
        <?php } ?>
    </dd>
    <?php } ?>
    <dt><?php echo T_('Status'); ?></dt>
    <dd>
        <?php if ($this->isOnline()) { ?>
        <i style="color:green;"><?php echo T_('User is Online Now'); ?></i>
        <?php } else { ?>
        <i style="color:red;"><?php echo T_('User is Offline Now'); ?></i>
        <?php } ?>
    </dd>
</dl><br />
<?php } ?>
<?php Ui::show_box_bottom(); ?>
<div class="tabs_wrapper">
    <div id="tabs_container">
        <ul id="tabs">
            <li class="tab_active"><a href="#recently_played"><?php echo T_('Played'); ?></a></li>
            <li><a href="#recently_skipped"><?php echo T_('Skipped'); ?></a></li>
            <?php if ($mayUpload) { ?>
            <li><a href="#artists"><?php echo T_('Artists'); ?></a></li>
            <?php } ?>
            <li><a href="#playlists"><?php echo T_('Playlists'); ?></a></li>
            <?php if ($isSociable) { ?>
            <li><a href="#following"><?php echo T_('Following'); ?></a></li>
            <li><a href="#followers"><?php echo T_('Followers'); ?></a></li>
            <li><a href="#timeline"><?php echo T_('Timeline'); ?></a></li>
            <?php } ?>
        </ul>
    </div>
    <div id="tabs_content">
        <div id="recently_played" class="tab_content" style="display: block;">
            <?php $items = $this->getTemporaryPlaylistItems();
if ($items !== []) {
    Ui::show_box_top(T_('Active Playlist')); ?>
            <table>
                <tr>
                    <td>
                        <?php foreach ($items as $item) { ?>
                        <?php echo $this->raw($this->itemLink($item['object_type'], $item['object_id'])); ?>
                        <br />
                        <?php } ?>
                    </td>
                </tr>
            </table><br />
            <?php Ui::show_box_bottom();
}

$recent = $this->getRecentlyPlayed();
echo $this->raw((new RecentlyPlayedView(
    ($recent->allTypes) ? RecentlyPlayedMode::ALL_TYPES : RecentlyPlayedMode::SONGS,
    $recent->data,
    $this->getClient(),
    $clientId,
    true,
    $webPath
))->render()); ?>
        </div>
        <div id="recently_skipped" class="tab_content">
            <?php $skipped = Stats::get_recently_played($clientId, 'skip', 'song', true);
Song::build_cache(array_keys($skipped));
echo $this->raw((new RecentlyPlayedView(RecentlyPlayedMode::SKIPPED, $skipped, $this->getClient(), $clientId, true, $webPath))->render()); ?>
        </div>
        <?php if ($mayUpload) { ?>
        <div id="artists" class="tab_content">
            <?php $browse = $this->createBrowse();
            $browse->set_type('artist', $this->getUploadsSql());
            $browse->set_sort('name', 'ASC', false);
            $browse->set_simple_browse(true);
            $browse->show_objects();
            $browse->store(); ?>
        </div>
        <?php } ?>
        <div id="playlists" class="tab_content">
            <?php $browse = $this->createBrowse();
$browse->set_type('playlist');
$browse->set_use_filters(false);
$browse->set_simple_browse(false);
$browse->show_objects($this->getPlaylistIds());
$browse->store(); ?>
        </div>
        <?php if ($isSociable) { ?>
        <div id="following" class="tab_content">
            <?php $browse = $this->createBrowse();
            $browse->set_type('user');
            $browse->set_use_filters(false);
            $browse->set_simple_browse(false);
            $browse->show_objects($this->getFollowing());
            $browse->store(); ?>
        </div>
        <div id="followers" class="tab_content">
            <?php $browse = $this->createBrowse();
            $browse->set_type('user');
            $browse->set_use_filters(false);
            $browse->set_simple_browse(false);
            $browse->show_objects($this->getFollowers());
            $browse->store(); ?>
        </div>
        <div id="timeline" class="tab_content">
            <?php echo $this->raw($this->getActivities()); ?>
        </div>
        <?php } ?>
    </div>
</div>
