// mood_cloud.phtml -- rendered by Ampache\Gui\Mood\MoodCloudView

use Ampache\Module\Api\Ajax;

/** @var Ampache\Gui\Mood\MoodCloudView $this */

echo $this->raw($this->getForm()->render());
echo $this->raw($this->getOrder()->render());

$browseArgument = '&browse_id=' . $this->getBrowseId();
$moods          = $this->getMoods();

Ajax::start_container('mood_filter'); ?>
<?php foreach ($moods as $mood) { ?>
<div class="tag_container">
    <div class="tag_button">
        <span id="click_mood_<?php echo $this->e($mood['id']); ?>"><?php echo $this->e($mood['name'] . ' (' . $mood['count'] . ')'); ?></span>
        <?php echo $this->raw(Ajax::observe('click_mood_' . $mood['id'], 'click', Ajax::action('?page=browse&action=browse' . $browseArgument . '&key=mood&mood=' . $mood['id'], ''))); ?>
    </div>
</div>
<?php } ?>
<br /><br /><br />
<?php if ($this->getShowMood() !== null) { ?>
<script>
$(document).ready(function () {
    <?php echo $this->raw(Ajax::action('?page=browse&action=browse' . $browseArgument . '&key=mood&mood=' . $this->getShowMood(), '')); ?>
});
</script>
<?php } ?>
<?php if ($moods === []) { ?>
<span class="fatalerror"><?php echo T_('Not Enough Data'); ?></span>
<?php } ?>
<?php Ajax::end_container(); ?>
