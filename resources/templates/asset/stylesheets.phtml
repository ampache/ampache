// asset/stylesheets.phtml -- rendered by Ampache\Gui\Asset\StylesheetsView

/** @var Ampache\Gui\Asset\StylesheetsView $this */
?>
<?php foreach ($this->getLibraries() as $url) { ?>
<link rel="stylesheet" href="<?php echo $this->e($url); ?>" type="text/css" media="screen">
<?php } ?>
<?php foreach ($this->getThemeSheets() as $sheet) { ?>
<link rel="stylesheet" href="<?php echo $this->e($sheet['url']); ?>" type="text/css" media="<?php echo $this->e($sheet['media']); ?>">
<?php } ?>
<link rel="stylesheet" href="<?php echo $this->e($this->getBaseUrl()); ?>" type="text/css" media="screen">
<link rel="stylesheet" href="<?php echo $this->e($this->getColourUrl()); ?>" type="text/css" media="screen">
<link rel="stylesheet" href="<?php echo $this->e($this->getPrintUrl()); ?>" type="text/css" media="print">
<?php if ($this->showRtl()) { ?>
<link rel="stylesheet" href="<?php echo $this->e($this->getRtlUrl()); ?>" type="text/css" media="screen">
<?php } ?>
<?php if ($this->hasCustomStylesheet()) { ?>
<link rel="stylesheet" href="<?php echo $this->e($this->getCustomUrl()); ?>" type="text/css" media="screen">
<?php } ?>
<?php echo $this->raw($this->getCustomStyle()); ?>
