// asset/scripts.phtml -- rendered by Ampache\Gui\Asset\ScriptsView

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Asset\ScriptsView $this */

$webPath = $this->getWebPath();
// js_globals.php reads both of these from this scope
$web_path         = $webPath;
$ajaxUriRetriever = $this->getAjaxUriRetriever(); ?>
<?php foreach ($this->getLibraries() as $library) { ?>
<script src="<?php echo $this->e($library['url']); ?>"<?php echo ($library['defer']) ? ' defer' : ''; ?>></script>
<?php } ?>
<?php require_once Ui::find_template('js_globals.php'); ?>
<?php if ($this->isDevServer()) { ?>
<script type="module" src="http://localhost:5177/@vite/client" crossorigin></script>
<script type="module" src="http://localhost:5177/src/js/main.js" crossorigin></script>
<?php } elseif (($entrypoint = $this->getEntrypointUrl()) !== null) { ?>
<script type="module" src="<?php echo $this->e($entrypoint); ?>" crossorigin></script>
<?php } else { ?>
<script>console.warn("No vite manifest file was found")</script>
<?php } ?>
<?php if ($this->hasCustomScript()) { ?>
<script src="<?php echo $this->e($webPath); ?>/lib/javascript/custom.js" defer></script>
<?php } ?>
