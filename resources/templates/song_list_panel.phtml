// song_list_panel.phtml -- rendered by Ampache\Gui\Song\SongListPanelView

use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;

/** @var Ampache\Gui\Song\SongListPanelView $this */

$columns = $this->getColumns();
$songs   = $this->getSongs();
$script  = $this->getOnRenderScript();
if ($this->areRatingsShown()) {
    Rating::build_cache('song', $this->getSongIds());
    Userflag::build_cache('song', $this->getSongIds());
} ?>
<table id="<?php echo $this->e($this->getTableId()); ?>" class="tabledata striped-rows">
    <thead>
    <tr class="th-top">
        <?php foreach ($columns as $column) { ?>
        <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
        <?php } ?>
    </tr>
    </thead>
    <tbody>
        <?php foreach ($songs as $song) { ?>
        <tr id="song_<?php echo $this->e($song->id); ?>">
            <?php echo $this->raw($this->renderRow($song)); ?>
        </tr>
        <?php } ?>
        <?php if ($songs === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
</table>
<?php if ($script !== null) { ?>
<script><?php echo $this->raw($script); ?></script>
<?php } ?>
