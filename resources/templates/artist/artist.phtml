<?php [$sort, $order] = $this->getSort();
foreach ($this->getMultiObjectIds() as $key => $objectIds) {
    $browse = $this->createBrowse();
    $browse->set_type($this->getObjectType());
    $browse->set_use_filters(false);
    if ($isAlbumType) {
        $browse->set_sort($sort, $order, false);
    }

    $browse->set_use_alpha(false, false);
    if ($key !== '') {
        $browse->set_content_div_ak($key);
    }

    $browse->show_objects($objectIds, ['group_disks' => true, 'title' => ($key !== '') ? ucwords($key) : '']);
    $browse->store();
} ?>
