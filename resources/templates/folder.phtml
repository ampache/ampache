// folder.phtml -- rendered by Ampache\Gui\Folder\FolderView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Folder\FolderView $this */

$folder   = $this->getFolder();
$folderId = $folder->getId();

echo $this->raw($this->getBrowseForm());
Ui::show_box_top($this->raw($this->getTitle()), 'info-box'); ?>
<div class="item_right_info">
</div>
<?php // the root listing is a virtual folder with nothing to act on, so the panel is omitted rather than drawn empty
if ($this->isPlayShown() || $this->isQueueShown()) { ?>
<div id="information_actions">
    <h3><?php echo T_('Actions'); ?></h3>
    <ul>
    <?php if ($this->isPlayShown()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=folder&object_id=' . $folderId, 'play_circle', T_('Play'), 'directplay_full_' . $folderId)); ?></li>
        <?php if ($this->isAutoplayNextEnabled()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=folder&object_id=' . $folderId . '&playnext=true', 'menu_open', T_('Play next'), 'nextplay_folder_' . $folderId)); ?></li>
        <?php }

        if ($this->isAutoplayAppendEnabled()) { ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?page=stream&action=directplay&object_type=folder&object_id=' . $folderId . '&append=true', 'low_priority', T_('Play last'), 'addplay_folder_' . $folderId)); ?></li>
        <?php }
        }

    if ($this->isQueueShown()) {
        $addToList = Ui::get_add_to_list_label(); ?>
        <li><?php echo $this->raw(Ajax::button_with_text('?action=basket&type=folder&id=' . $folderId, 'new_window', T_('Add to Temporary Playlist'), 'play_full_' . $folderId)); ?></li>
        <li><?php echo $this->raw(Ajax::button_with_text('?action=basket&type=folder_random&id=' . $folderId, 'shuffle', T_('Random to Temporary Playlist'), 'play_random_' . $folderId)); ?></li>
        <li>
            <a id="add_to_playlist_<?php echo $this->e($folderId); ?>" onclick="showPlaylistDialog(event, 'folder', '<?php echo $this->e($folderId); ?>')">
                <?php echo $this->raw(Ui::get_material_symbol('playlist_add', $addToList)); ?>
                <?php echo $this->e($addToList); ?>
            </a>
        </li>
    <?php } ?>
    </ul>
</div>
<?php }

Ui::show_box_bottom(); ?>
<div id="additional_information">
&nbsp;
</div>
<div id="reordered_list_<?php echo $this->e($folderId); ?>">
<?php $browse = $this->getBrowse();
$browse->show_objects();
$browse->store(); ?>
</div>
