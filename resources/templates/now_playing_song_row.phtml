// now_playing_song_row.phtml -- rendered by Ampache\Gui\NowPlaying\NowPlayingSongRowView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;

/** @var Ampache\Gui\NowPlaying\NowPlayingSongRowView $this */

$songId = $this->getSongId(); ?>
<div class="np_group" id="np_group_1">
    <div class="np_cell cel_username">
        <label><?php echo T_('Username'); ?></label>
        <a title="<?php echo $this->e($this->getAgent()); ?>" href="<?php echo $this->e($this->getClientUrl()); ?>">
            <?php echo $this->e($this->getClientName()); ?>
            <div><?php echo $this->raw($this->getAvatar()); ?></div>
        </a>
    </div>
</div>
<div class="np_group" id="np_group_2">
    <div class="np_cell cel_left">
        <label><?php echo T_('Song'); ?></label>
        <?php echo $this->raw($this->getSongLink()); ?>
    </div>
    <div class="np_cell cel_left">
        <label><?php echo T_('Album'); ?></label>
        <?php echo $this->raw($this->getAlbumLink()); ?>
    </div>
    <div class="np_cell cel_left">
        <label><?php echo T_('Artist'); ?></label>
        <?php echo $this->raw($this->getArtistLink()); ?>
    </div>
    <div class="np_cell cel_left">
        <label><?php echo T_('Year'); ?></label>
        <a href="<?php echo $this->e($this->getYearUrl()); ?>"><?php echo $this->e($this->getYear()); ?></a>
    </div>
    <?php if ($this->hasGenres()) { ?>
    <div id="np_song_tags_<?php echo $songId; ?>" class="np_cell cel_left">
        <label><?php echo T_('Genres'); ?></label>
        <?php // get_f_tags() builds its own escaped links?>
        <?php echo $this->raw($this->getGenres()); ?>
    </div>
    <?php } ?>
</div>
<div class="np_group" id="np_group_3">
    <div id="album_<?php echo $this->e($this->getAlbumId()); ?>" class="np_cell cel_albumart libitem_menu" data-object-type="album" data-object-id="<?php echo $this->e($this->getAlbumId()); ?>">
        <?php echo $this->raw($this->getArt()); ?>
    </div>
</div>
<?php if ($this->showSimilar()) { ?>
<div class="np_group similars" id="similar_items_<?php echo $songId; ?>">
    <div class="np_group similars">
        <div class="np_cell cel_similar">
            <label><?php echo T_('Similar Artists'); ?></label>
            <p><?php echo T_('Loading...'); ?></p>
        </div>
    </div>
    <div class="np_group similars">
        <div class="np_cell cel_similar">
            <label><?php echo T_('Similar Songs'); ?></label>
            <p><?php echo T_('Loading...'); ?></p>
        </div>
    </div>
</div>
<script>
$(document).ready(function () {
    <?php echo $this->raw(Ajax::action($this->getSimilarAction(), 'similar_now_playing')); ?>
});
</script>
<?php } ?>
<?php if ($this->showUserBlock()) { ?>
<div class="np_group" id="np_group_4">
    <?php if ($this->showRatings()) { ?>
    <span id="rating_<?php echo $songId; ?>_song"><?php echo $this->raw(Rating::show($songId, 'song')); ?></span>
    <span id="userflag_<?php echo $songId; ?>_song"><?php echo $this->raw(Userflag::show($songId, 'song')); ?></span>
    <?php } ?>
</div>
<?php } ?>
