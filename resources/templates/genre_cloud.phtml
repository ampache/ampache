// genre_cloud.phtml -- rendered by Ampache\Gui\Genre\GenreCloudView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Genre\GenreCloudView $this */

echo $this->raw($this->getForm()->render());
echo $this->raw($this->getOrder()->render());

$browseArgument = '&browse_id=' . $this->getBrowseId();
$genres         = $this->getGenres();

Ajax::start_container('tag_filter'); ?>
<div class="tag_container">
    <div class="tag_button">
        <span id="click_tag_no_genre"><?php echo $this->e('[' . T_('No Genre') . ']'); ?></span>
        <?php echo $this->raw(Ajax::observe('click_tag_no_genre', 'click', Ajax::action('?page=browse&action=browse' . $browseArgument . '&key=no_genre&tag=-1', ''))); ?>
    </div>
</div>
<?php foreach ($genres as $genre) { ?>
<div class="tag_container">
    <div class="tag_button">
        <span id="click_tag_<?php echo $this->e($genre['id']); ?>"><?php echo $this->e($genre['name'] . ' (' . $genre['count'] . ')'); ?></span>
        <?php echo $this->raw(Ajax::observe('click_tag_' . $genre['id'], 'click', Ajax::action('?page=browse&action=browse' . $browseArgument . '&key=tag&tag=' . $genre['id'], ''))); ?>
    </div>
    <?php if ($this->mayEdit()) { ?>
    <div class="tag_actions">
        <ul>
            <li>
                <a class="tag_edit" id="edit_tag_<?php echo $this->e($genre['id']); ?>" onclick="showEditDialog('tag_row', '<?php echo $this->e($genre['id']); ?>', 'edit_tag_<?php echo $this->e($genre['id']); ?>', '<?php echo addslashes(T_('Edit')); ?>', 'click_tag_', '<?php echo $this->e($this->getBrowseArgument()); ?>')">
                    <?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?>
                </a>
            </li>
            <li>
                <a class="tag_delete" href="<?php echo $this->e($this->getAjaxUri()); ?>?page=tag&action=delete&tag_id=<?php echo $this->e($genre['id']); ?>" data-confirm="<?php echo T_('Do you really want to delete this Tag?'); ?>"><?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?></a>
            </li>
        </ul>
    </div>
    <?php } ?>
</div>
<?php } ?>
<br /><br /><br />
<?php if ($this->getShowGenre() !== null) { ?>
<script>
$(document).ready(function () {
    <?php echo $this->raw(Ajax::action('?page=browse&action=browse' . $browseArgument . '&key=tag&tag=' . $this->getShowGenre(), '')); ?>
});
</script>
<?php } ?>
<?php if ($genres === []) { ?>
<span class="fatalerror"><?php echo T_('Not Enough Data'); ?></span>
<?php } ?>
<?php Ajax::end_container(); ?>
