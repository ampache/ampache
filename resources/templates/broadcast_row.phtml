// broadcast_row.phtml -- rendered by Ampache\Gui\Broadcast\BroadcastRowView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Broadcast\BroadcastRowView $this */

$broadcast = $this->getBroadcast(); ?>
<td class="cel_play">
    <span class="cel_play_content">&nbsp;</span>
    <div class="cel_play_hover">
    <?php if ($this->isDirectPlayEnabled()) {
        echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=broadcast&object_id=' . $broadcast->id, 'play_circle', T_('Play'), 'play_broadcast_' . $broadcast->id));
    } ?>
    </div>
</td>
<td class="cel_name"><?php echo $this->raw($broadcast->get_f_link()); ?></td>
<td class="cel_genre"><?php echo $this->raw($broadcast->get_f_tags()); ?></td>
<td class="cel_started"><?php echo $broadcast->started ? T_('Yes') : T_('No'); ?></td>
<td class="cel_listeners"><?php echo $this->e($broadcast->listeners); ?></td>
<td class="cel_action">
<?php if ($this->mayManage()) { ?>
    <a id="edit_broadcast_<?php echo $this->e($broadcast->getId()); ?>" onclick="showEditDialog('broadcast_row', '<?php echo $this->e($broadcast->getId()); ?>', 'edit_broadcast_<?php echo $this->e($broadcast->getId()); ?>', '<?php echo addslashes(T_('Broadcast Edit')); ?>', 'broadcast_row_')"><?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?></a>
    <a href="<?php echo $this->e($this->getDeleteUrl()); ?>"><?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?></a>
<?php } ?>
</td>
