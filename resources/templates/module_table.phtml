// module_table.phtml -- rendered by the Ampache\Gui\Admin module table views

/** @var Ampache\Gui\Admin\AbstractModuleTableView $this */

$columns = $this->getColumns();
$rows    = $this->getRows(); ?>
<table class="tabledata striped-rows">
    <thead>
        <tr class="th-top">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($rows as $row) { ?>
        <tr>
            <?php foreach ($columns as $index => $column) { ?>
            <td class="<?php echo $this->e($column['class']); ?>"><?php echo $this->raw($row[$index] ?? ''); ?></td>
            <?php } ?>
        </tr>
        <?php } ?>
        <?php if ($rows === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="error"><?php echo T_('Found nothing to show'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <?php foreach ($columns as $column) { ?>
            <th class="<?php echo $this->e($column['class']); ?>"><?php echo $this->e($column['label']); ?></th>
            <?php } ?>
        </tr>
    </tfoot>
</table>
<br />
