// lyrics.phtml -- rendered by Ampache\Gui\Song\LyricsView

use Ampache\Module\Art\Art;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Song\LyricsView $this */

$song = $this->getSong();

Ui::show_box_top(T_('Song Lyrics'), 'box box_lyrics_song');
if ($this->hasAlbumArt()) {
    Art::display('album', $song->album, $this->getAlbumName(), ['width' => 128, 'height' => 128]);
}

$lyricsUrl = $this->getLyricsUrl(); ?>
<div class="np_group">
  <div class="np_cell">
      <label><?php echo T_('Song'); ?>:</label>
      <a title="<?php echo $this->e($song->title); ?>" href="<?php echo $this->e($this->getSongUrl()); ?>">
          <?php echo $this->e($song->title); ?>
      </a>
  </div>

  <div class="np_cell">
      <label><?php echo T_('Album'); ?>:</label>
      <a title="<?php echo $this->e($this->getAlbumName()); ?>" href="<?php echo $this->e($this->getAlbumUrl()); ?>">
              <?php echo $this->e($this->getAlbumName()); ?>
      </a>
  </div>

  <div class="np_cell">
      <label><?php echo T_('Artist'); ?>:</label>
      <a title="<?php echo $this->e($this->getArtistName()); ?>" href="<?php echo $this->e($this->getArtistUrl()); ?>">
              <?php echo $this->e($this->getArtistName()); ?>
      </a>
  </div>
</div>
<?php if ($this->mayEdit()) { ?>
<div id="information_actions">
    <h3><?php echo T_('Actions'); ?></h3>
    <ul>
        <?php $lookupLabel = ($this->isStored()) ? T_('Refresh') : T_('Get Lyrics'); ?>
        <li>
            <a href="<?php echo $this->e($this->getRefreshUrl()); ?>">
                <?php echo $this->raw(Ui::get_material_symbol(($this->isStored()) ? 'refresh' : 'search', $lookupLabel)); ?>
                <?php echo $this->e($lookupLabel); ?>
            </a>
        </li>
        <li>
            <a data-title="<?php echo $this->e(T_('Song Edit')); ?>" onclick="showEditDialog('song_row', '<?php echo $song->getId(); ?>', 'edit_song_<?php echo $song->getId(); ?>', $(this).data('title'), '')">
                <?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit'))); ?>
                <?php echo T_('Edit'); ?>
            </a>
        </li>
        <?php if ($this->isStored()) { ?>
        <li>
            <a data-confirm-text="<?php echo $this->e($this->getClearConfirmation()); ?>" onclick="window.ampacheConfirm($(this).data('confirm-text')).then(function (ok) { if (ok) { $('#lyrics_clear_form').trigger('submit'); } })">
                <?php echo $this->raw(Ui::get_material_symbol('clear_all', T_('Clear'))); ?>
                <?php echo T_('Clear'); ?>
            </a>
        </li>
        <?php } ?>
    </ul>
    <?php if ($this->isStored()) { ?>
    <form id="lyrics_clear_form" method="post" action="<?php echo $this->e($this->getFormUrl()); ?>">
        <?php echo $this->raw($this->getFormToken()); ?>
        <input type="hidden" name="lyrics_action" value="clear" />
    </form>
    <?php } ?>
</div>
<?php } else { ?>
<br /><br />
<?php } ?>
<div class="lyrics">
    <div id="lyrics_text"><?php echo $this->raw($this->getLinesView()->render()); ?></div>
<?php if ($this->isUserSet()) { ?>
    <div class="lyrics_source"><?php echo T_('User set'); ?></div>
<?php } ?>
<?php if ($lyricsUrl !== null) { ?>
    <div id="lyrics_url"><a href="<?php echo $this->e($lyricsUrl); ?>" target="_blank"><?php echo T_('Show more'); ?></a></div>
<?php } ?>
</div>
<?php Ui::show_box_bottom();

$candidates = $this->getCandidates();
if ($candidates === [] && $this->isRefreshed()) {
    Ui::show_box_top(T_('Plugins'), 'box box_lyrics_plugins');
    echo T_('No lyrics found.');
    Ui::show_box_bottom();
}
if ($candidates !== []) {
    Ui::show_box_top(T_('Plugins'), 'box box_lyrics_plugins');
    foreach ($candidates as $candidate) { ?>
<div class="lyrics_candidate">
    <form class="lyrics_candidate_header" method="post" action="<?php echo $this->e($this->getFormUrl()); ?>">
        <?php echo $this->raw($this->getFormToken()); ?>
        <input type="hidden" name="lyrics_action" value="save" />
        <input type="hidden" name="lyrics" value="<?php echo $this->e($candidate['text']); ?>" />
        <strong class="lyrics_candidate_plugin"><?php echo $this->e($candidate['plugin']); ?></strong>
        <?php if ($candidate['url'] !== null) { ?>
        <a class="lyrics_candidate_link" href="<?php echo $this->e($candidate['url']); ?>" target="_blank"><?php echo T_('Show more'); ?></a>
        <?php } ?>
        <input class="lyrics_candidate_select" type="submit" value="<?php echo $this->e(T_('Select')); ?>" />
    </form>
    <details>
        <summary><?php echo T_('Lyrics'); ?></summary>
        <div class="lyrics_candidate_text"><?php echo $this->raw(nl2br($this->e($candidate['text']))); ?></div>
    </details>
</div>
<?php }
    Ui::show_box_bottom();
} ?>
