// lyrics_lines.phtml -- rendered by Ampache\Gui\Song\LyricsLinesView

/** @var Ampache\Gui\Song\LyricsLinesView $this */

$syncedLines = $this->getSyncedLines();
if ($syncedLines !== []) { ?>
<div class="lyrics_lines lyrics_synced" data-song-id="<?php echo $this->getSongId(); ?>" data-offset="<?php echo $this->getOffset(); ?>">
<?php foreach ($syncedLines as $line) { ?>
    <p data-start="<?php echo $line['start']; ?>"<?php if ($line['end'] !== null) { ?> data-end="<?php echo $line['end']; ?>"<?php } ?>><?php echo $this->e($line['value']); ?></p>
<?php } ?>
</div>
<?php } else { ?>
<div class="lyrics_lines"><?php echo $this->raw($this->getLyrics()); ?></div>
<?php } ?>
