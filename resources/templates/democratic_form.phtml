// democratic_form.phtml -- rendered by Ampache\Gui\Playback\DemocraticFormView

use Ampache\Module\System\Core;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Playback\DemocraticFormView $this */

$level = $this->getLevel();
Ui::show_box_top(T_('Configure Democratic Playlist')); ?>
<form method="post" action="<?php echo $this->e($this->getFormAction()); ?>" enctype="multipart/form-data">
    <table class="tabledata">
        <tr>
            <td><?php echo T_('Name'); ?></td>
            <td><input type="text" name="name" value="<?php echo $this->e($this->getName()); ?>" /></td>
        </tr>
        <tr>
            <td><?php echo T_('Base Playlist'); ?></td>
            <td><?php echo $this->raw($this->getBasePlaylistSelect()); ?></td>
        </tr>
        <tr>
            <td><?php echo T_('Cooldown Time'); ?></td>
            <td><input type="text" maxlength="6" name="cooldown" value="<?php echo $this->e($this->getCooldown()); ?>" />&nbsp;(<?php echo T_('minutes'); ?>)</td>
        </tr>
        <tr>
            <td><?php echo T_('Level'); ?></td>
            <td>
                <select name="level">
                    <?php foreach ($this->getLevels() as $value => $label) { ?>
                    <option value="<?php echo $value; ?>"<?php echo ($value === $level) ? ' selected="selected"' : ''; ?>><?php echo $this->e($label); ?></option>
                    <?php } ?>
                </select>
            </td>
        </tr>
        <tr>
            <td><?php echo T_('Make Default'); ?></td>
            <td><input type="checkbox" name="make_default" value="1" <?php echo ($this->isPrimary()) ? 'checked' : ''; ?> /></td>
        </tr>
    </table>
    <div class="formValidation">
        <?php echo $this->raw(Core::form_register('create_democratic')); ?>
        <input type="submit" value="<?php echo $this->e(T_('Update')); ?>" />
    </div>
</form>
<?php Ui::show_box_bottom(); ?>
