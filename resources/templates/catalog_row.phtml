// catalog_row.phtml -- rendered by Ampache\Gui\Catalog\CatalogRowView

use Ampache\Module\Api\Ajax;

/** @var Ampache\Gui\Catalog\CatalogRowView $this */

$catalog = $this->getCatalog();
$flip    = $this->getFlipState(); ?>
<td class="cel_catalog"><?php echo $this->raw($catalog->get_f_link()); ?></td>
<td class="cel_info"><?php echo $this->e($catalog->get_f_info()); ?></td>
<td class="cel_lastverify"><?php echo $this->e($catalog->get_f_update()); ?></td>
<td class="cel_lastadd"><?php echo $this->e($catalog->get_f_add()); ?></td>
<td class="cel_lastclean"><?php echo $this->e($catalog->get_f_clean()); ?></td>
<td class="cel_action cel_action_text">
<?php if (!$this->isReady()) { ?>
    <a href="<?php echo $this->e($this->getMakeReadyUrl()); ?>"><b><?php echo T_('Make it ready ..'); ?></b></a><br />
<?php } ?>
<form name="catalog_action_<?php echo $this->e($catalog->id); ?>" method="post" action="<?php echo $this->e($this->getActionUrl()); ?>">
    <label>
        <select name="action">
        <?php foreach ($this->getActions() as $value => $label) { ?>
            <option value="<?php echo $this->e($value); ?>"><?php echo $this->e($label); ?></option>
        <?php } ?>
        </select>
    </label>
    <div class="formValidation">
        <input class="button" type="submit" value="<?php echo T_('Go'); ?>" />
        <input type="hidden" name="catalogs[]" value="<?php echo $this->e($catalog->id); ?>" />
    </div>
    <?php if ($this->mayDisable()) { ?>
    <span id="<?php echo $this->e($flip['id']); ?>">
        <?php echo $this->raw(Ajax::button('?page=catalog&action=flip_state&catalog_id=' . $catalog->id, $flip['symbol'], $flip['label'], 'flip_state_' . $catalog->id)); ?>
    </span>
    <?php } ?>
</form>
</td>
