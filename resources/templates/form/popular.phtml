// popular.phtml -- rendered by Ampache\Gui\Form\PopularFormView

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Form\PopularFormView $this */
?>

<h3 class="box-title"><?php echo T_('Popular'); ?></h3>

<div class="category_options">
    <a class="category <?php echo ($this->getFilter() == 'popular_song') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_song"><?php echo T_('Songs'); ?></a>
    <a class="category <?php echo ($this->getFilter() == 'popular_album_disk' || $this->getFilter() == 'popular_album') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_<?php echo $this->e($this->getAlbumString()); ?>"><?php echo T_('Albums'); ?></a>
    <?php if ($this->isShowArtist() || $this->getFilter() == 'popular_artist') { ?>
        <a class="category <?php echo ($this->getFilter() == 'popular_artist') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_artist"><?php echo T_('Artists'); ?></a>
    <?php } ?>
    <?php if ($this->isShowAlbumArtist() || !$this->isShowArtist() || $this->getFilter() == 'popular_album_artist') { ?>
        <a class="category <?php echo ($this->getFilter() == 'popular_album_artist') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_album_artist"><?php echo T_('Album Artists'); ?></a>
    <?php } ?>
    <?php if ($this->isPodcastEnabled()) { ?>
        <a class="category <?php echo ($this->getFilter() == 'popular_podcast_episode') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_podcast_episode"><?php echo T_('Podcast Episodes'); ?></a>
    <?php }
    if ($this->isVideoEnabled()) { ?>
        <a class="category <?php echo ($this->getFilter() == 'popular_video') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_video"><?php echo T_('Videos'); ?></a>
    <?php } ?>
    <a class="category <?php echo ($this->getFilter() == 'popular_playlist') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=popular_playlist"><?php echo T_('Playlists'); ?></a>
</div>
<div id="information_actions">
    <ul>
        <li>
            <?php if ($this->isByUser()) { ?>
                <a href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=<?php echo $this->e($this->getFilter()); ?>&by_user=0">
                    <?php echo Ui::get_material_symbol('group', T_('Show All')); ?>
                    <?php echo T_('Show All'); ?>
                </a>
            <?php } else { ?>
                <a href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=<?php echo $this->e($this->getFilter()); ?>&by_user=1">
                    <?php echo Ui::get_material_symbol('person', T_('Personal')); ?>
                    <?php echo T_('Personal'); ?>
                </a>
            <?php } ?>
</div>
