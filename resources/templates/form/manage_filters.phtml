// manage_filters.phtml -- rendered by Ampache\Gui\Form\ManageFiltersView

use Ampache\Gui\Partial\CatalogFilterRowView;

/** @var Ampache\Gui\Form\ManageFiltersView $this */
$t_name      = T_('Filter Name');
$t_num_users = T_('Number of Users');
$t_num_cats  = T_('Number of Catalogs');
$t_actions   = T_('Actions');
$adminPath   = $this->getWebPath();
$mayEdit     = $this->mayEdit(); ?>
<div id="information_actions">
    <ul style="float: left;">
        <li>
            <a class="option-list" href="<?php echo $this->e($this->getWebPath()); ?>/filter.php?action=show_add_filter"><?php echo T_('Add Catalog Filter'); ?></a>
        </li>
    </ul>
</div>
<table class="tabledata striped-rows" data-objecttype="filter">
    <thead>
        <tr class="th-top">
            <th class="cel_name essential persist"><?php echo T_('Filter name'); ?></th>
            <th class="cel_num_users essential"><?php echo T_('Users'); ?></th>
            <th class="cel_num_catalogs essential"><?php echo T_('Catalogs'); ?></th>
            <th class="cel_action cel_action_text essential"><?php echo T_('Actions'); ?></th>
        </tr>
    </thead>
    <tbody>
<?php foreach ($this->getFilters() as $filter) { ?>
        <tr id="<?php echo $this->e($filter['name']); ?>">
            <?php echo $this->raw((new CatalogFilterRowView(
                $adminPath,
                (int) $filter['id'],
                (string) $filter['name'],
                (int) $filter['userCount'],
                (int) $filter['catalogCount'],
                $mayEdit
            ))->render()); ?>
        </tr>
<?php } ?>
    </tbody>
    <tfoot>
        <tr class="th-bottom">
            <th class="cel_name"><?php echo $t_name; ?></th>
            <th class="cel_num_users"><?php echo $t_num_users; ?></th>
            <th class="cel_num_catalogs"><?php echo $t_num_cats; ?></th>
            <th class="cel_action cel_action_text"><?php echo $t_actions; ?></th>
        </tr>
    </tfoot>
</table>
