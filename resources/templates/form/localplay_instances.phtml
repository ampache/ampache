// localplay_instances.phtml -- rendered by Ampache\Gui\Form\LocalplayInstancesView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Form\LocalplayInstancesView $this */

Ui::show_box_top(T_('Show Localplay Instances'), 'box box_localplay_instances'); ?>
<table class="tabledata striped-rows">
<tr>
    <?php foreach ($this->getFields() as $key => $field) { ?>
        <th><?php echo $this->e($field['description']); ?></th>
    <?php } ?>
    <th><?php echo T_('Action'); ?></th>
</tr>
<?php foreach ($this->getInstances() as $uid => $name) {
    $instance = $this->getLocalplay()->get_instance((string) $uid); ?>
<tr id="localplay_instance_<?php echo $this->e($uid); ?>">
    <?php foreach ($this->getFields() as $key => $field) { ?>
    <td>
        <?php
        if (isset($instance[$key])) {
            // a stored password is never echoed back, only shown as present
            echo ($field['type'] != 'password') ? $this->e((string) $instance[$key]) : '*****';
        } ?>
    </td>
    <?php } ?>
    <td>
        <a href="<?php echo $this->e($this->getWebPath()); ?>/localplay.php?action=edit_instance&instance=<?php echo $this->e($uid); ?>"><?php echo $this->raw(Ui::get_material_symbol('edit', T_('Edit Instance'))); ?></a>
        <?php echo $this->raw(Ajax::button('?page=localplay&action=delete_instance&instance=' . $uid, 'close', T_('Delete'), 'delete_instance_' . $uid, '', '', T_('Are you sure?'))); ?>
    </td>
</tr>
<?php
} ?>
</table>
<?php Ui::show_box_bottom(); ?>
