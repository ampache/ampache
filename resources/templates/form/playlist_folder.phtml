// form/playlist_folder.phtml -- rendered by Ampache\Gui\Form\PlaylistFolderFormView

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Form\PlaylistFolderFormView $this */

$isEdit   = $this->isEdit();
$action   = ($isEdit) ? 'edit' : 'create';
$parentId = $this->getParentId();

Ui::show_box_top(($isEdit) ? T_('Edit Folder') : T_('Create Folder'), 'box box_playlist_folder'); ?>
<form name="playlist_folder" method="post" action="<?php echo $this->e($this->getWebPath()); ?>/playlist_folder.php?action=<?php echo $action; ?>">
<table class="tabledata">
<tr>
    <td><?php echo T_('Name'); ?></td>
    <td><input type="text" name="name" value="<?php echo $this->e($this->getName()); ?>" autofocus />
        <?php echo $this->raw($this->getError('name')); ?>
    </td>
</tr>
<tr>
    <td><?php echo T_('Parent'); ?></td>
    <td>
        <select name="parent">
            <option value="0"<?php echo ($parentId === 0) ? ' selected="selected"' : ''; ?>><?php echo T_('None'); ?></option>
            <?php foreach ($this->getParentOptions() as $option) { ?>
            <option value="<?php echo $option['id']; ?>"<?php echo ($option['id'] === $parentId) ? ' selected="selected"' : ''; ?>><?php echo str_repeat('-- ', $option['depth']) . $this->e($option['name']); ?></option>
            <?php } ?>
        </select>
        <?php echo $this->raw($this->getError('parent')); ?>
    </td>
</tr>
</table>
<div class="formValidation">
    <?php if ($isEdit) { ?>
    <input type="hidden" name="folder" value="<?php echo $this->getFolderId(); ?>" />
    <?php echo $this->raw($this->getFormToken('edit_playlist_folder')); ?>
    <?php } else { ?>
    <?php echo $this->raw($this->getFormToken('add_playlist_folder')); ?>
    <?php } ?>
    <input class="button" type="submit" value="<?php echo ($isEdit) ? T_('Save') : T_('Create'); ?>" />
</div>
</form>
<?php Ui::show_box_bottom(); ?>
