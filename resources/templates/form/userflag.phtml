// userflag.phtml -- rendered by Ampache\Gui\Form\UserflagFormView

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Form\UserflagFormView $this */
?>

<h3 class="box-title"><?php echo T_('Favorites'); ?></h3>

<div class="category_options">
    <a class="category <?php echo ($this->getFilter() == 'userflag_song') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_song"><?php echo T_('Songs'); ?></a>
    <a class="category <?php echo ($this->getFilter() == 'userflag_album_disk' || $this->getFilter() == 'userflag_album') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_<?php echo $this->e($this->getAlbumString()); ?>"><?php echo T_('Albums'); ?></a>
    <?php if ($this->isShowArtist() || $this->getFilter() == 'userflag_artist') { ?>
        <a class="category <?php echo ($this->getFilter() == 'userflag_artist') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_artist"><?php echo T_('Artists'); ?></a>
    <?php } ?>
    <?php if ($this->isShowAlbumArtist() || !$this->isShowArtist() || $this->getFilter() == 'userflag_album_artist') { ?>
        <a class="category <?php echo ($this->getFilter() == 'userflag_album_artist') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_album_artist"><?php echo T_('Album Artists'); ?></a>
    <?php } ?>
    <?php if ($this->isPodcastEnabled()) { ?>
        <a class="category <?php echo ($this->getFilter() == 'userflag_podcast_episode') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_podcast_episode"><?php echo T_('Podcast Episodes'); ?></a>
    <?php }
    if ($this->isVideoEnabled()) { ?>
        <a class="category <?php echo ($this->getFilter() == 'userflag_video') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_video"><?php echo T_('Videos'); ?></a>
    <?php } ?>
    <a class="category <?php echo ($this->getFilter() == 'userflag_playlist') ? 'current' : ''; ?>" href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=userflag_playlist"><?php echo T_('Playlists'); ?></a>
</div>
<div id="information_actions">
    <ul>
        <li>
        <?php if ($this->isByUser()) { ?>
            <a href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=<?php echo $this->e($this->getFilter()); ?>&by_user=0">
                <?php echo Ui::get_material_symbol('group', T_('Show All')); ?>
                <?php echo T_('Show All'); ?>
            </a>
        <?php } else { ?>
            <a href="<?php echo $this->e($this->getWebPath()); ?>/stats.php?action=<?php echo $this->e($this->getFilter()); ?>&by_user=1">
                <?php echo Ui::get_material_symbol('person', T_('Personal')); ?>
                <?php echo T_('Personal'); ?>
            </a>
        <?php } ?>
</div>
