// partial/multiselect_actions.phtml -- rendered by Ampache\Gui\Partial\MultiselectActionsView

use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Partial\MultiselectActionsView $this */

$actions = $this->getActions();
if ($actions === []) {
    return;
} ?>
<div class="multiselect-actions multiselect-empty" data-multiselect-bar>
    <span class="multiselect-summary">
        <?php printf(T_('%s selected'), '<span data-multiselect-count>0</span>'); ?>
    </span>
    <?php foreach ($actions as $action) { ?>
    <a href="javascript:void(0);" aria-disabled="true"
       data-multiselect-action="<?php echo $this->e($action['action']); ?>"
       data-multiselect-url="<?php echo $this->e($action['url']); ?>"
       <?php if (!empty($action['confirm'])) { ?>data-multiselect-confirm="<?php echo $this->e($action['confirm']); ?>"<?php } ?>
    >
        <?php echo $this->raw(Ui::get_material_symbol($action['icon'], $action['text'])); ?>
        <span class="multiselect-label"><?php echo $this->e($action['text']); ?></span>
    </a>
    <?php } ?>
</div>
