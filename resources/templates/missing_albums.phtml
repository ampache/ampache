// missing_albums.phtml -- rendered by Ampache\Gui\Wanted\MissingAlbumsView

use Ampache\Gui\Wanted\WantedAlbumRowView;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Wanted\MissingAlbumsView $this */

$albums  = $this->getAlbums();
$columns = [T_('Album'), T_('Artist'), T_('Year'), T_('User'), T_('Actions')];

Ui::show_box_top(T_('Missing Albums'), 'info-box'); ?>
<table class="tabledata striped-rows">
    <thead>
        <tr class="th-top">
            <th class="cel_album"><?php echo $this->e($columns[0]); ?></th>
            <th class="cel_artist"><?php echo $this->e($columns[1]); ?></th>
            <th class="cel_year"><?php echo $this->e($columns[2]); ?></th>
            <th class="cel_user"><?php echo $this->e($columns[3]); ?></th>
            <th class="cel_action"><?php echo $this->e($columns[4]); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($albums as $album) { ?>
        <tr id="walbum_<?php echo $this->e($album->mbid); ?>">
            <?php echo $this->raw((new WantedAlbumRowView($album))->render()); ?>
        </tr>
        <?php } ?>
        <?php if ($albums === []) { ?>
        <tr>
            <td colspan="<?php echo count($columns); ?>"><span class="nodata"><?php echo T_('No missing albums found'); ?></span></td>
        </tr>
        <?php } ?>
    </tbody>
</table>
<?php Ui::show_box_bottom(); ?>
