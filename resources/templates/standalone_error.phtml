        <?php Ui::show_custom_style(); ?>
        <link rel="stylesheet" href="<?php echo $this->e($this->getWebPath()); ?>/lib/components/bootstrap/css/bootstrap.min.css">
        <link rel="stylesheet" href="<?php echo $this->e($this->getWebPath()); ?>/templates/install.css" type="text/css" media="screen">
    </head>
    <body>
        <div class="navbar navbar-dark navbar-inverse navbar-fixed-top" role="navigation">
            <div class="container" style="height: 70px;">
