// label_row.phtml -- rendered by Ampache\Gui\Label\LabelRowView

use Ampache\Module\Art\Art;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Label\LabelRowView $this */

$label = $this->getLabel(); ?>
<td class="<?php echo $this->e($this->getCoverCellClass()); ?>">
    <?php Art::display('label', $label->id, $this->getName(), ['width' => 100, 'height' => 100], $this->getLabelUrl()); ?>
</td>
<td class="cel_label"><?php echo $this->raw($label->get_f_link()); ?></td>
<td class="cel_category"><?php echo $this->e($label->category); ?></td>
<td class="cel_artists"><?php echo $this->e($label->get_artist_count()); ?></td>
<td class="cel_country"><?php echo $this->e($label->country); ?></td>
<td class="cel_active"><?php echo $label->active ? T_('Active') : T_('Inactive'); ?></td>
<td class="cel_action">
<?php if ($this->mayInteract()) {
    if ($this->mayAddToPlaylist()) { ?>
    <a id="add_to_playlist_<?php echo $this->e($label->id); ?>" onclick="showPlaylistDialog(event, 'label', '<?php echo $this->e($label->id); ?>')">
        <?php echo $this->raw(Ui::get_material_symbol('playlist_add', Ui::get_add_to_list_label())); ?>
    </a>
    <?php }

    if ($this->isSociable()) { ?>
    <a href="<?php echo $this->e($this->getWebPath()); ?>/shout.php?action=show_add_shout&type=label&id=<?php echo $this->e($label->id); ?>">
        <?php echo $this->raw(Ui::get_material_symbol('comment', T_('Post Shout'))); ?>
    </a>
    <?php }

    if ($this->mayDelete()) { ?>
    <a id="delete_label_<?php echo $this->e($label->id); ?>" href="<?php echo $this->e($this->getWebPath()); ?>/labels.php?action=delete&label_id=<?php echo $this->e($label->id); ?>">
        <?php echo $this->raw(Ui::get_material_symbol('close', T_('Delete'))); ?>
    </a>
    <?php }
    } ?>
</td>
