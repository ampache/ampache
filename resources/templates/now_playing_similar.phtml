// now_playing_similar.phtml -- rendered by Ampache\Gui\Index\NowPlayingSimilarView

/** @var Ampache\Gui\Index\NowPlayingSimilarView $this */

$artistLinks = $this->getArtistLinks();
$songLinks   = $this->getSongLinks();
if ($artistLinks !== []) { ?>
<div class="np_group similars">
    <div class="np_cell cel_similar">
        <label><?php echo T_('Similar Artists'); ?></label>
        <?php foreach ($artistLinks as $link) { ?>
            <div class="np_cell cel_similar_artist"><?php echo $this->raw($link); ?></div>
        <?php } ?>
    </div>
</div>
<?php }

if ($songLinks !== []) { ?>
<div class="np_group similars">
    <div class="np_cell cel_similar">
        <label><?php echo T_('Similar Songs'); ?></label>
        <?php foreach ($songLinks as $link) { ?>
            <div class="np_cell cel_similar_song"><?php echo $this->raw($link); ?></div>
        <?php } ?>
    </div>
</div>
<?php } ?>
