// sidebar/sidebar.phtml -- rendered by Ampache\Gui\Sidebar\SidebarView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Sidebar\SidebarView $this */
?>
<ul id="sidebar-tabs">
<?php if ($this->isRegistered()) {
    foreach ($this->getTabs() as $tab) { ?>
        <li id="sb_tab_<?php echo $this->e($tab['id']); ?>" class="sb1<?php echo ($this->isActive($tab['id'])) ? ' active' : ''; ?>">
            <?php echo $this->raw(Ajax::button('?page=index&action=sidebar&button=' . $tab['id'], $tab['icon'], $tab['title'], 'sidebar_' . $tab['id'])); ?>
            <?php if ($this->isActive($tab['id'])) { ?>
            <div id="sidebar-page" class="sidebar-page-float">
                <?php echo $this->raw($this->renderTab($tab['id'])); ?>
            </div>
            <?php } ?>
        </li>
    <?php }
    if ($this->showAdminLocked()) { ?>
        <li id="sb_tab_admin" class="sb1"><?php echo $this->raw(Ui::get_material_symbol('lock', T_('Admin Disabled'))); ?></li>
    <?php }
    if ($this->showLogout()) { ?>
    <li id="sb_tab_logout" class="sb1">
        <a target="_top" href="<?php echo $this->e($this->getLogoutUrl()); ?>" id="sidebar_logout" class="nohtml">
            <?php echo $this->raw(Ui::get_material_symbol('logout', T_('Log out'))); ?>
        </a>
    </li>
    <?php }
    } else { ?>
    <li id="sb_tab_home" class="sb1">
        <div id="sidebar-page" class="sidebar-page-float">
            <?php echo $this->raw($this->renderTab('home')); ?>
        </div>
    </li>
<?php } ?>
</ul>
<script>
    $(function() {
        $(".header").click(function () {
            $header = $(this);
            $content = $header.next();
            // slideToggle's callback runs after the animation, so the cookie records the settled state
            $content.slideToggle(500, function() {
                $header.children(".header-img").toggleClass("expanded collapsed");
                var sbstate = "expanded";
                if ($header.children(".header-img").hasClass("collapsed")) {
                    sbstate = "collapsed";
                }
                Cookies.set('sb_' + $header.children(".header-img").attr('id'), sbstate, {<?php echo $this->raw($this->getCookieOptions()); ?>});
            });
        });
    });

    $(document).ready(function() {
        var cookieArray = document.cookie.split(";");
        var result = new Array();
        for (var elem in cookieArray) {
            var temp = cookieArray[elem].split("=");
            temp[0] = $.trim(temp[0]);
            temp[1] = $.trim(temp[1]);
            // only sb_* cookies are sidebar state
            if (temp[0].substring(0, 3) == "sb_") {
                result[temp[0].substring(3)] = temp[1];
            }
        }
        for (var key in result) {
            if ($("#" + key).length && result[key] == "collapsed") {
                if ($("#" + key).hasClass("expanded")) {
                    $("#" + key).removeClass("expanded");
                    $("#" + key).addClass("collapsed");
                    $("#" + key).parent().next().slideToggle(0);
                }
            }
        }
    });
</script>
