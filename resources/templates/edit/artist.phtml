// edit/artist.phtml -- rendered by Ampache\Gui\Edit\Renderer\ArtistEditFormRenderer

/** @var Ampache\Gui\Edit\Renderer\ArtistEditFormRenderer $this */

$artistId = $this->getArtistId();
$ownerId  = $this->getOwnerId(); ?>
<div>
    <form method="post" id="edit_artist_<?php echo $artistId; ?>" class="edit_dialog_content">
        <table class="tabledata">
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Name'); ?></td>
                <td><input type="text" name="name" value="<?php echo $this->e($this->getName()); ?>" autofocus /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('MusicBrainz ID'); ?></td>
                <td>
                    <?php if ($this->mayEditMbid()) { ?>
                    <input type="text" name="mbid" value="<?php echo $this->e($this->getMbid()); ?>" />
                    <?php } else { ?>
                    <input type="hidden" name="mbid" value="<?php echo $this->e($this->getMbid()); ?>" /><?php echo $this->e($this->getMbid()); ?>
                    <?php } ?>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Summary'); ?></td>
                <td><textarea name="summary" cols="44" rows="4"><?php echo $this->e($this->getSummary()); ?></textarea></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Place Formed'); ?></td>
                <td><input type="text" name="placeformed" value="<?php echo $this->e($this->getPlaceFormed()); ?>" /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Year Formed'); ?></td>
                <td><input type="text" name="yearformed" value="<?php echo $this->e($this->getYearFormed()); ?>" /></td>
            </tr>
            <tr>
                <td><?php echo T_('Owner'); ?><br /></td>
                <td>
                    <?php if ($this->mayManage()) { ?>
                    <select name="user">
                        <option value="0"<?php echo ($ownerId === 0) ? ' selected="selected"' : ''; ?>></option>
                        <?php foreach ($this->getUsers() as $userId => $username) {
                            if ($userId < 1) {
                                continue;
                            } ?>
                        <option value="<?php echo $this->e($userId); ?>"<?php echo ($userId === $ownerId) ? ' selected="selected"' : ''; ?>><?php echo $this->e($username); ?></option>
                        <?php } ?>
                    </select>
                    <?php } else { ?>
                    <input type="hidden" name="user" value="<?php echo $ownerId; ?>" /><?php echo $ownerId; ?>
                    <?php } ?>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Genres'); ?></td>
                <?php // Tag::get_display() escapes the link text and title itself?>
                <td><input type="text" name="edit_tags" id="edit_tags" value="<?php echo $this->raw($this->getGenres()); ?>" /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Moods'); ?></td>
                <?php // Mood::get_display() escapes the names itself and adds no markup without a link?>
                <td><input type="text" name="edit_moods" id="edit_moods" value="<?php echo $this->raw($this->getMoods()); ?>" /></td>
            </tr>
            <?php if ($this->showLabels()) { ?>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Labels'); ?></td>
                <?php // Label::get_display() escapes each name itself?>
                <td><input type="text" name="edit_labels" id="edit_labels" value="<?php echo $this->raw($this->getLabels()); ?>" /></td>
            </tr>
            <?php } ?>
            <tr>
                <td class="edit_dialog_content_header"></td>
                <td><input type="checkbox" name="overwrite_childs" value="checked" />&nbsp;<?php echo T_('Overwrite tags of sub albums and sub songs'); ?></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"></td>
                <td><input type="checkbox" name="add_to_childs" value="checked" />&nbsp;<?php echo T_('Add tags to sub albums and sub songs'); ?></td>
            </tr>
        </table>
        <input type="hidden" name="id" value="<?php echo $artistId; ?>" />
        <input type="hidden" name="type" value="artist_row" />
    </form>
</div>
