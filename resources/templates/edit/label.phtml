// edit/label.phtml -- rendered by Ampache\Gui\Edit\Renderer\LabelEditFormRenderer

/** @var Ampache\Gui\Edit\Renderer\LabelEditFormRenderer $this */

$labelId  = $this->getLabelId();
$category = $this->getCategory(); ?>
<div>
    <form method="post" id="edit_label_<?php echo $labelId; ?>" class="edit_dialog_content">
        <table class="tabledata">
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Name'); ?></td>
                <td><input type="text" name="name" value="<?php echo $this->e($this->getName()); ?>" autofocus /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('MusicBrainz ID'); ?></td>
                <td>
                    <?php if ($this->mayEditMbid()) { ?>
                    <input type="text" name="mbid" value="<?php echo $this->e($this->getMbid()); ?>" />
                    <?php } else { ?>
                    <input type="hidden" name="mbid" value="<?php echo $this->e($this->getMbid()); ?>" /><?php echo $this->e($this->getMbid()); ?>
                    <?php } ?>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Category'); ?></td>
                <td>
                    <select name="category">
                        <?php foreach ($this->getCategories() as $value => $label) { ?>
                        <option value="<?php echo $this->e($value); ?>"<?php echo ($value === $category) ? ' selected="selected"' : ''; ?>><?php echo $this->e($label); ?></option>
                        <?php } ?>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Summary'); ?></td>
                <td><textarea name="summary" cols="44" rows="4"><?php echo $this->e($this->getSummary()); ?></textarea></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Address'); ?></td>
                <td><input type="text" name="address" value="<?php echo $this->e($this->getAddress()); ?>" /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Country'); ?></td>
                <td><input type="text" name="country" value="<?php echo $this->e($this->getCountry()); ?>" /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('E-mail'); ?></td>
                <td><input type="text" name="email" value="<?php echo $this->e($this->getEmail()); ?>" /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Website'); ?></td>
                <td><input type="text" name="website" value="<?php echo $this->e($this->getWebsite()); ?>" /></td>
            </tr>
            <tr>
                <td><?php echo T_('Status'); ?></td>
                <td>
                    <select name="active">
                        <option value="1"<?php echo ($this->isActive()) ? ' selected="selected"' : ''; ?>><?php echo T_('Active'); ?></option>
                        <option value="0"<?php echo ($this->isActive()) ? '' : ' selected="selected"'; ?>><?php echo T_('Inactive'); ?></option>
                    </select>
                </td>
            </tr>
        </table>
        <input type="hidden" name="id" value="<?php echo $labelId; ?>" />
        <input type="hidden" name="type" value="label_row" />
    </form>
</div>
