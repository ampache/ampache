// edit/playlist.phtml -- rendered by Ampache\Gui\Edit\Renderer\PlaylistEditFormRenderer

/** @var Ampache\Gui\Edit\Renderer\PlaylistEditFormRenderer $this */

$playlistId   = $this->getPlaylistId();
$type         = $this->getType();
$ownerId      = $this->getOwnerId();
$collaborates = $this->getCollaborateIds();
$isSmartlist  = $this->isSmartlist();
$folderId     = $this->getFolderId();
$mayEdit      = $this->mayEditFields(); ?>
<div>
    <form method="post" id="edit_playlist_<?php echo $playlistId; ?>" class="edit_dialog_content">
        <table class="tabledata">
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Name'); ?></td>
                <td><?php if ($mayEdit) { ?>
                    <input type="text" name="name" value="<?php echo $this->e($this->getName()); ?>" autofocus />
                    <?php } else {
                        echo $this->e($this->getName());
                    } ?>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Type'); ?></td>
                <td><?php if ($mayEdit) { ?>
                    <select name="playlist_type">
                        <option value="public"<?php echo ($type === 'public') ? ' selected="selected"' : ''; ?>><?php echo T_('Public'); ?></option>
                        <option value="private"<?php echo ($type !== 'public') ? ' selected="selected"' : ''; ?>><?php echo T_('Private'); ?></option>
                    </select>
                    <?php } else {
                        echo ($type === 'public') ? T_('Public') : T_('Private');
                    } ?>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Folder'); ?></td>
                <td>
                    <select name="folder">
                        <option value="0"<?php echo ($folderId === 0) ? ' selected="selected"' : ''; ?>><?php echo T_('None'); ?></option>
                        <?php foreach ($this->getFolderOptions() as $option) { ?>
                        <option value="<?php echo $option['id']; ?>"<?php echo ($option['id'] === $folderId) ? ' selected="selected"' : ''; ?>><?php echo str_repeat('-- ', $option['depth']) . $this->e($option['name']); ?></option>
                        <?php } ?>
                    </select>
                </td>
            </tr>
            <?php if ($isSmartlist) { ?>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Random'); ?></td>
                <td><?php if ($mayEdit) {
                    // the hidden zero posts first so unchecking is a value; `update()` ignores the key when absent?>
                    <input type="hidden" name="random" value="0" /><input type="checkbox" name="random" value="1" <?php echo ($this->isRandom()) ? 'checked' : ''; ?> />
                    <?php } else {
                        echo ($this->isRandom()) ? T_('Yes') : T_('No');
                    } ?>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Item Limit (0 = unlimited)'); ?></td>
                <td><?php if ($mayEdit) { ?>
                    <input type="number" name="limit" value="<?php echo $this->e($this->getLimit()); ?>" />
                    <?php } else {
                        echo ($this->getLimit() > 0) ? $this->e($this->getLimit()) : T_('None');
                    } ?>
                </td>
            </tr>
            <?php } ?>
            <tr>
                <td><?php echo T_('Owner'); ?><br /></td>
                <td><?php if ($mayEdit) { ?>
                    <select name="playlist_user">
                        <?php foreach ($this->getUsers() as $userId => $username) { ?>
                        <option value="<?php echo $this->e($userId); ?>"<?php echo ($userId === $ownerId) ? ' selected="selected"' : ''; ?>><?php echo $this->e($username); ?></option>
                        <?php } ?>
                    </select>
                    <?php } else {
                        echo $this->e($this->getOwnerUsername());
                    } ?>
                </td>
            </tr>
            <tr>
                <td><?php echo T_('Collaborate'); ?><br /></td>
                <td><?php if ($mayEdit) { ?>
                    <select multiple size="5" name="collaborate[]" class="collaborate-select">
                        <?php foreach ($this->getCollaborators() as $userId => $username) { ?>
                        <option value="<?php echo $this->e($userId); ?>"<?php echo (in_array($userId, $collaborates, true)) ? ' selected="selected"' : ''; ?>><?php echo $this->e($username); ?></option>
                        <?php } ?>
                    </select>
                    <?php } else {
                        echo $this->e($this->getCollaboratorNames());
                    } ?>
                </td>
            </tr>
        </table>
        <input type="hidden" name="id" value="<?php echo $playlistId; ?>" />
        <input type="hidden" name="type" value="<?php echo ($isSmartlist) ? 'search_row' : 'playlist_row'; ?>" />
    </form>
</div>
