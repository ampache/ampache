// edit/collection.phtml -- rendered by Ampache\Gui\Edit\Renderer\CollectionEditFormRenderer

/** @var Ampache\Gui\Edit\Renderer\CollectionEditFormRenderer $this */

$collectionId = $this->getCollectionId();
$type         = $this->getType();
$objectType   = $this->getObjectType();
$types        = $this->getSelectableTypes();
$collaborates = $this->getCollaborateIds(); ?>
<div>
    <form method="post" id="edit_collection_<?php echo $collectionId; ?>" class="edit_dialog_content">
        <table class="tabledata">
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Name'); ?></td>
                <td><input type="text" name="name" value="<?php echo $this->e($this->getName()); ?>" autofocus /></td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Type'); ?></td>
                <td>
                    <select name="collection_type">
                        <option value="public"<?php echo ($type === 'public') ? ' selected="selected"' : ''; ?>><?php echo T_('Public'); ?></option>
                        <option value="private"<?php echo ($type !== 'public') ? ' selected="selected"' : ''; ?>><?php echo T_('Private'); ?></option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Object Type'); ?></td>
                <td>
                    <select name="object_type"<?php echo ($types === []) ? ' disabled="disabled"' : ''; ?>>
                        <option value=""<?php echo ($objectType === '') ? ' selected="selected"' : ''; ?>><?php echo T_('Mixed'); ?></option>
                        <?php foreach ($types as $selectable) { ?>
                        <option value="<?php echo $this->e($selectable); ?>"<?php echo ($selectable === $objectType) ? ' selected="selected"' : ''; ?>><?php echo $this->e($selectable); ?></option>
                        <?php } ?>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="edit_dialog_content_header"><?php echo T_('Collaborate'); ?></td>
                <td>
                    <select multiple size="5" name="collaborate[]" style="height: 90px;">
                        <?php foreach ($this->getCollaborators() as $userId => $username) { ?>
                        <option value="<?php echo $this->e($userId); ?>"<?php echo (in_array($userId, $collaborates, true)) ? ' selected="selected"' : ''; ?>><?php echo $this->e($username); ?></option>
                        <?php } ?>
                    </select>
                </td>
            </tr>
        </table>
        <input type="hidden" name="id" value="<?php echo $collectionId; ?>" />
        <input type="hidden" name="type" value="collection_row" />
    </form>
</div>
