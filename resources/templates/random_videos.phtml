// random_videos.phtml -- rendered by Ampache\Gui\Index\RandomVideosView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Art\Art;
use Ampache\Module\Statistics\Rating;
use Ampache\Module\Statistics\Userflag;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Index\RandomVideosView $this */

$button = Ajax::button('?page=index&action=random_videos', 'refresh', T_('Refresh'), 'random_video_refresh');

Ui::show_box_top($this->getTitle() . ' ' . $button, 'box box_random_videos');
foreach ($this->getVideos() as $video) { ?>
    <div class="random_video">
        <div id="video_<?php echo $this->e($video->id); ?>" class="art_album libitem_menu" data-object-type="video" data-object-id="<?php echo $this->e($video->id); ?>">
            <?php $shown = ($video->get_default_art_kind() === 'preview')
                && Art::display('video', $video->id, $video->getFileName(), $this->getPreviewSize(), $video->get_link(), false, true, 'preview');
    if (!$shown) {
        Art::display('video', $video->id, $video->getFileName(), $this->getArtSize(), $video->get_link());
    } ?>
        </div>
        <div class="play_video">
        <?php if ($this->isDirectPlayEnabled()) {
            echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=video&object_id=' . $video->id, 'play_circle', T_('Play'), 'play_video_' . $video->id));
            if ($this->isAutoplayNextEnabled()) {
                echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=video&object_id=' . $video->id . '&playnext=true', 'menu_open', T_('Play next'), 'nextplay_video_' . $video->id));
            }

            if ($this->isAutoplayAppendEnabled()) {
                echo $this->raw(Ajax::button('?page=stream&action=directplay&object_type=video&object_id=' . $video->id . '&append=true', 'low_priority', T_('Play last'), 'addplay_video_' . $video->id));
            }
        } ?>
        </div>
        <?php if ($this->areRatingsShown()) { ?>
        <div class="rating">
            <span class="cel_rating" id="rating_<?php echo $this->e($video->id); ?>_video"><?php echo $this->raw(Rating::show($video->id, 'video')); ?></span>
            <span class="cel_rating" id="userflag_<?php echo $this->e($video->id); ?>_video"><?php echo $this->raw(Userflag::show($video->id, 'video')); ?></span>
        </div>
        <?php } ?>
    </div>
<?php }

Ui::show_box_bottom();
