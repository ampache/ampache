// index/home.phtml -- rendered by Ampache\Gui\Index\HomeView

use Ampache\Module\Api\Ajax;
use Ampache\Module\Util\Ui;

/** @var Ampache\Gui\Index\HomeView $this */
?>
<div id="browse_header">
    <?php echo $this->raw($this->getHeaderForm()); ?>
</div>
<div id="home_plugin" style="display:flex;flex-direction:column;">
    <?php foreach ($this->getPluginWidgets() as $widget) {
        echo $this->raw($widget);
    } ?>
</div>
<?php if ($this->showNowPlaying()) { ?>
<div id="now_playing">
    <?php show_now_playing(); ?>
</div>
<?php } ?>
<?php if ($this->showMomentAlbums()) {
    echo $this->raw(Ajax::observe('window', 'load', Ajax::action($this->getRandomAlbumAction(), 'random_albums'))); ?>
<div id="random_selection" class="random_selection">
    <?php Ui::show_box_top(T_('Albums of the Moment'));
    echo T_('Loading...');
    Ui::show_box_bottom(); ?>
</div>
<?php } ?>
<?php if ($this->showMomentVideos()) {
    echo $this->raw(Ajax::observe('window', 'load', Ajax::action('?page=index&action=random_videos', 'random_videos'))); ?>
<div id="random_video_selection" class="random_selection">
    <?php Ui::show_box_top(T_('Videos of the Moment'));
    echo T_('Loading...');
    Ui::show_box_bottom(); ?>
</div>
<?php } ?>
<?php if ($this->showRecentlyPlayed()) { ?>
<div id="recently_played">
    <?php echo $this->raw($this->getRecentlyPlayed()); ?>
</div>
<?php } ?>
