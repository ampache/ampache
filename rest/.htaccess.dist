<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # /{version}/{format}/catalogs/{catalog_id}/browse/{object_type}/{object_id} | `?action=browse&filter={album_id}&type=album&catalog={catalog_id}`
    RewriteRule ^(3|4|5|6|8)/(json|xml)/catalogs/(-?[0-9]+)/browse/([^/]+)/(-?[0-9]+)/?$ /server/$2.rest.php?version=$1&action=browse&filter=$5&type=$4&catalog=$3 [L,QSA]
    # /{version}/{format}/me/(playlists|smartlists)
    RewriteRule ^(3|4|5|6|8)/(json|xml)/me/(playlists|smartlists)/?$ /server/$2.rest.php?version=$1&action=user_$3 [L,QSA]
    # /{version}/{format}/me/(now-playing|last-shouts|friends-timeline|lost-password)
    RewriteRule ^(3|4|5|6|8)/(json|xml)/me/(now-playing|last-shouts|friends-timeline|lost-password)/?$ /server/$2.rest.php?version=$1&action=$3 [L,QSA]
    # /{version}/{format}/preferences/(system|user)
    RewriteRule ^(3|4|5|6|8)/(json|xml)/preferences/(system|user)/?$ /server/$2.rest.php?version=$1&action=$3_preferences [L,QSA]
    # /{version}/{format}/{type}/(deleted|stats|search)
    RewriteRule ^(3|4|5|6|8)/(json|xml)/([^/]+)/(deleted|stats|search|system|user)/?$ /server/$2.rest.php?version=$1&action=$4&type=$3 [L,QSA]
    # /{version}/{format}/folders/{integer}
    RewriteRule ^(3|4|5|6|8)/(json|xml)/folders/(-?[0-9]+)/?$ /server/$2.rest.php?version=$1&action=folders&filter=$3 [L,QSA]
    # /{version}/{format}/folders{path}
    RewriteRule ^(3|4|5|6|8)/(json|xml)/folders(.+)/?$ /server/$2.rest.php?version=$1&action=folders&filter=$3 [L,QSA,B]
    # /{version}/{format}/playlist-folders/{integer}/items
    RewriteRule ^(8)/(json|xml)/playlist-folders/([0-9]+)/items/?$ /server/$2.rest.php?version=$1&action=playlist_folder_items&filter=$3 [L,QSA]
    # /{version}/{format}/playlist-folders/{integer}
    RewriteRule ^(8)/(json|xml)/playlist-folders/([0-9]+)/?$ /server/$2.rest.php?version=$1&action=playlist_folder&filter=$3 [L,QSA]
    # /{version}/{format}/playlist-folders{path}/items
    RewriteRule ^(8)/(json|xml)/playlist-folders(/.+)/items/?$ /server/$2.rest.php?version=$1&action=playlist_folder_items&filter=$3 [L,QSA,B]
    # /{version}/{format}/playlist-folders{path}
    RewriteRule ^(8)/(json|xml)/playlist-folders(/.+?)/?$ /server/$2.rest.php?version=$1&action=playlist_folder&filter=$3 [L,QSA,B]
    # /{version}/{format}/localplay/songs -> its own action (a sub-resource, not a `localplay/{command}`)
    RewriteRule ^(3|4|5|6|8)/(json|xml)/localplay/songs/?$ /server/$2.rest.php?version=$1&action=localplay_songs [L,QSA]
    # /{version}/{format}/{type}/{filter}/{action}
    RewriteRule ^(3|4|5|6|8)/(json|xml)/([^/]+)/([^/]+)/([^/]+)/?$ /server/$2.rest.php?version=$1&action=$5&type=$3&filter=$4 [L,QSA]
    # /{version}/{format}/{action}/{filter}
    RewriteRule ^(3|4|5|6|8)/(json|xml)/([^/]+)/([^/]+)/?$ /server/$2.rest.php?version=$1&action=$3&filter=$4 [L,QSA]
    # /{version}/{format}/{action}
    RewriteRule ^(3|4|5|6|8)/(json|xml)/([^/]+)/?$ /server/$2.rest.php?version=$1&action=$3 [L,QSA]
    # /{version}/{format} with no resource at all (e.g. opening the api url in a browser); the handler pings
    RewriteRule ^(3|4|5|6|8)/(json|xml)/?$ /server/$2.rest.php?version=$1 [L,QSA]
    # subsonic clients using *.view
    RewriteRule ^([^/]+)\.view$ index.php?ssaction=$1 [L,QSA]
    # some subsonic clients don't use *.view
    RewriteRule ^([^/]+)/?$ index.php?ssaction=$1 [L,QSA]
    RewriteRule ^fake/(.+)$ /play/$1 [L,QSA]
</IfModule>
