parameters:
  level: 8
  tmpDir: build/phpstan
  reportUnmatchedIgnoredErrors: false
  paths:
    - public
    - src
    - resources/templates
  fileExtensions:
    - php
    - phtml
  excludePaths:
    - public/lib
    - public/themes
    - public/upnp
    - public/ample (?)
    - public/foam (?)
    - tests
includes:
    - phpstan-baseline.neon
