msgstr "\"ampache.cfg.php.dist\" قابل خواندن است"

msgid "This tests whether the configuration template can be read."
msgstr "این آزمایش نشان میدهد که آیا الگوی پیکربندی قابل خواندن است یا خیر."

msgid "\"ampache.sql\" is readable"
msgstr "\"ampache.sql\" قابل خواندن است"

msgid ""
"This tests whether the file needed to initialize the database structure is "
